    "keybindings": [
      {
        "key": "Ctrl+Enter",
        "mac": "Cmd+Enter",
        "command": "fusionPowerUser.executeSQL",
        "when": "editorFocus && (resourceScheme == query-preview || (fusionPowerUser.inProject || resourceScheme == untitled) && resourceLangId =~ /^sql$|^jinja-sql$/)"
      },
      {
        "key": "Ctrl+'",
        "mac": "Cmd+'",
        "command": "fusionPowerUser.sqlPreview",
        "when": "editorTextFocus && (resourceScheme == query-preview || (fusionPowerUser.inProject || resourceScheme == untitled) && resourceLangId =~ /^sql$|^jinja-sql$/)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "fusionPowerUser.executeSQL",
          "when": "resourceScheme == query-preview || (fusionPowerUser.inProject || resourceScheme == untitled) && resourceLangId =~ /^sql$|^jinja-sql$/",
          "group": "navigation@1"
        },
        {
          "command": "fusionPowerUser.previewMaterialized",
          "when": "fusionPowerUser.inProject && resourceScheme == file && resourceExtname == .sql",
          "group": "navigation@2"
        },
        {
          "command": "fusionPowerUser.runCurrentModel",
          "when": "resourceScheme == query-preview || (fusionPowerUser.inProject || resourceScheme == untitled) && resourceLangId =~ /^sql$|^jinja-sql$/",
          "group": "navigation@3"
        },
        {
          "command": "fusionPowerUser.testCurrentModel",
          "when": "resourceScheme == query-preview || (fusionPowerUser.inProject || resourceScheme == untitled) && resourceLangId =~ /^sql$|^jinja-sql$/",
          "group": "navigation@4"
        },
        {
          "command": "fusionPowerUser.sqlPreview",
          "when": "resourceScheme == query-preview || (fusionPowerUser.inProject || resourceScheme == untitled) && resourceLangId =~ /^sql$|^jinja-sql$/",
          "group": "navigation@5"
        }
      ],
      "editor/context": [
        {
          "submenu": "fusionPowerUser.editorContext",
          "group": "dbt@1",
          "when": "resourceScheme == query-preview || (fusionPowerUser.inProject || resourceScheme == untitled) && resourceLangId =~ /^sql$|^jinja-sql$/"
        }
      ],
      "fusionPowerUser.editorContext": [
        {
          "command": "fusionPowerUser.runCurrentModel",
          "group": "1_run@1"
        },
        {
          "command": "fusionPowerUser.testCurrentModel",
          "group": "1_run@2"
        },
        {
          "submenu": "fusionPowerUser.buildModel",
          "group": "1_run@3"
        },
        {
          "command": "fusionPowerUser.compileCurrentModel",
          "group": "2_compile@1"
        },
        {
          "command": "fusionPowerUser.showCompiledSQL",
          "group": "2_compile@2"
        },
        {
          "command": "fusionPowerUser.previewMaterialized",
          "when": "fusionPowerUser.inProject && resourceScheme == file",
          "group": "2_compile@3"
        },
        {
          "command": "fusionPowerUser.goToDocumentationEditor",
          "group": "3_docs@1"
        },
        {
          "command": "fusionPowerUser.recordColumnTypes",
          "group": "3_docs@2"
        },
        {
          "command": "fusionPowerUser.pullUpstreamDescriptions",
          "group": "3_docs@3"
        }
      ],
      "editor/title/run": [
        {
          "command": "fusionPowerUser.buildCurrentProject",
          "when": "resourceScheme == query-preview || (fusionPowerUser.inProject || resourceScheme == untitled) && resourceLangId =~ /^sql$|^jinja-sql$/",
          "group": "inline"
        },
        {
          "command": "fusionPowerUser.buildCurrentModel",
          "when": "resourceScheme == query-preview || (fusionPowerUser.inProject || resourceScheme == untitled) && resourceLangId =~ /^sql$|^jinja-sql$/",
          "group": "inline"
        },
        {
          "command": "fusionPowerUser.buildChildrenModels",
          "when": "resourceScheme == query-preview || (fusionPowerUser.inProject || resourceScheme == untitled) && resourceLangId =~ /^sql$|^jinja-sql$/",
          "group": "inline"
        },
        {
          "command": "fusionPowerUser.buildParentModels",
          "when": "resourceScheme == query-preview || (fusionPowerUser.inProject || resourceScheme == untitled) && resourceLangId =~ /^sql$|^jinja-sql$/",
          "group": "inline"
        },
        {
          "command": "fusionPowerUser.buildChildrenParentModels",
          "when": "resourceScheme == query-preview || (fusionPowerUser.inProject || resourceScheme == untitled) && resourceLangId =~ /^sql$|^jinja-sql$/",
          "group": "inline"
        },
        {
          "command": "fusionPowerUser.runCurrentModel",
          "when": "resourceScheme == query-preview || (fusionPowerUser.inProject || resourceScheme == untitled) && resourceLangId =~ /^sql$|^jinja-sql$/",
          "group": "inline"
        },
        {
          "command": "fusionPowerUser.cleanCurrentProject",
          "when": "resourceScheme == query-preview || (fusionPowerUser.inProject || resourceScheme == untitled) && resourceLangId =~ /^sql$|^jinja-sql$/",
          "group": "inline"
        }
      ],
      "view/title": [
        {
          "command": "fusionPowerUser.testCurrentModel",
          "when": "view == model_test_treeview",
          "group": "navigation"
        },
        {
          "command": "fusionPowerUser.runChildrenModels",
          "when": "view == children_model_treeview",
          "group": "navigation"
        },
        {
          "command": "fusionPowerUser.runParentModels",
          "when": "view == parent_model_treeview",
          "group": "navigation"
        },
        {
          "command": "fusionPowerUser.clearRunHistory",
          "when": "view == run_history_treeview",
          "group": "2_clear"
        }
      ],
      "view/item/context": [
        {
          "command": "fusionPowerUser.rerunFromHistory",
          "when": "view == run_history_treeview && viewItem == runHistoryEntry",
          "group": "inline"
        },
        {
          "command": "fusionPowerUser.runTest",
          "when": "view == model_test_treeview && viewItem != source",
          "group": "inline"
        },
        {
          "command": "fusionPowerUser.runChildrenModels",
          "when": "view == children_model_treeview && viewItem != source",
          "group": "inline"
        },
        {
          "command": "fusionPowerUser.runParentModels",
          "when": "view == parent_model_treeview && viewItem != source",
          "group": "inline"
        },
        {
          "command": "fusionPowerUser.copyModelName",
          "when": "(view == parent_model_treeview || view == children_model_treeview || view == documentation_treeview) && viewItem != source",
          "group": "navigation"
        },
        {
          "command": "fusionPowerUser.previewMaterialized",
          "when": "(view == parent_model_treeview || view == children_model_treeview) && viewItem == model",
          "group": "navigation"
        },
        {
          "command": "fusionPowerUser.goToDocumentationEditor",
          "when": "view == documentation_treeview",
          "group": "inline"
        }
      ],
      "fusionPowerUser.buildModel": [
        {
          "command": "fusionPowerUser.buildCurrentModel",
          "when": "resourceScheme == query-preview || (fusionPowerUser.inProject || resourceScheme == untitled) && resourceLangId =~ /^sql$|^jinja-sql$/",
          "group": "inline"
        },
        {
          "command": "fusionPowerUser.buildChildrenModels",
          "when": "resourceScheme == query-preview || (fusionPowerUser.inProject || resourceScheme == untitled) && resourceLangId =~ /^sql$|^jinja-sql$/",
          "group": "inline"
        },
        {
          "command": "fusionPowerUser.buildParentModels",
          "when": "resourceScheme == query-preview || (fusionPowerUser.inProject || resourceScheme == untitled) && resourceLangId =~ /^sql$|^jinja-sql$/",
          "group": "inline"
        },
        {
          "command": "fusionPowerUser.buildChildrenParentModels",
          "when": "resourceScheme == query-preview || (fusionPowerUser.inProject || resourceScheme == untitled) && resourceLangId =~ /^sql$|^jinja-sql$/",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "fusionPowerUser.addToProjects",
          "when": "false"
        },
        {
          "command": "fusionPowerUser.rerunFromHistory",
          "when": "false"
        },
        {
          "command": "fusionPowerUser.copyModelName",
          "when": "false"
        },
        {
          "command": "fusionPowerUser.previewComputed",
          "when": "false"
        },
        {
          "command": "fusionPowerUser.recordColumnTypes",
          "when": "fusionPowerUser.inProject"
        },
        {
          "command": "fusionPowerUser.pullUpstreamDescriptions",
          "when": "fusionPowerUser.inProject"
        }
      ]
    },
    "submenus": [
      {
        "id": "fusionPowerUser.editorContext",
        "label": "dbt"
      },
      {
        "id": "fusionPowerUser.buildModel",
        "label": "Build dbt Model",
        "icon": {
          "light": "./media/images/build-model_light.svg",
          "dark": "./media/images/build-model_dark.svg"
        }
      }
    ],
    "languages": [
      {
        "id": "jinja-sql",
        "icon": {
          "light": "./media/images/dbt_file_icon.svg",
          "dark": "./media/images/dbt_file_icon.svg"
        },
        "filenamePatterns": [
          "**/models/**/*.sql",
          "**/macros/**/*.sql",
          "**/snapshots/**/*.sql",
          "**/analyses/**/*.sql",
          "**/tests/**/*.sql",
          "**/dbt_packages/**/*.sql"
        ]
      },
      {
        "id": "sql",
        "filenamePatterns": [
          "**/target/compiled/**/*.sql",
          "**/target/run/**/*.sql"
        ]
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "jinja-sql",
        "scopes": {
          "keyword": [
            "support.function.dbt.jinja"
          ]
        }
      },
      {
        "language": "sql",
        "scopes": {
          "keyword": [
            "support.function.dbt.jinja"
          ]
        }
      }
    ],
    "grammars": [
      {
        "language": "jinja-sql",
        "scopeName": "source.sql.jinja",
        "path": "./syntaxes/jinja-sql.tmLanguage.json"
      },
      {
        "scopeName": "source.yaml.jinja",
        "path": "./syntaxes/jinja-yaml.tmLanguage.json",
        "injectTo": [
          "source.yaml"
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build:contract && npm run build:app --workspace webview_panels && npm run build:app",
    "build:contract": "npm run build --workspace @fusion-power-user/webview-contract",
    "watch:contract": "npm run watch --workspace @fusion-power-user/webview-contract",
    "build": "npm run build:contract && npm run build:app",
    "build:app": "rsbuild build",
    "build:dev": "npm run build:contract && npm run build:dev:app",
    "build:dev:app": "rsbuild build --mode development",
    "watch:extension:app": "rsbuild build --mode development --watch",
    "compile": "node node_modules/typescript-7/bin/tsc -b && node node_modules/typescript-7/bin/tsc -p src/test/tsconfig.json",
    "compile:integration": "npm run build:contract && node node_modules/typescript-7/bin/tsc -p tsconfig.integration.json",
    "clean": "node -e \"for (const d of ['out','coverage','dist']) require('fs').rmSync(d,{recursive:true,force:true})\"",
    "format": "oxfmt \"**/*.{js,cjs,mjs,ts,tsx,css,html,json}\"",
    "lint:oxlint": "oxlint --deny-warnings --type-aware src scripts packages",
    "fix:oxlint": "oxlint --fix --type-aware src scripts packages",
    "prune:oxlint": "oxlint --prune-suppressions --type-aware src scripts packages",
    "lint:eslint": "eslint src scripts packages",
    "fix:eslint": "eslint src scripts packages --fix",
    "check:format": "oxfmt --check \"**/*.{js,cjs,mjs,ts,tsx,css,html,json}\"",
    "check:lockfile": "lockfile-lint --path package-lock.json --type npm --allowed-hosts npm --validate-https --validate-integrity",
    "test": "vitest run --coverage",
    "test:coverage": "vitest run --coverage",
    "test:integration": "node scripts/test/run-integration.mjs",
    "package:vsix": "vsce package",
    "prune:eslint": "eslint src scripts packages --prune-suppressions",
    "lint:unused": "knip --no-progress --no-tag-hints && knip --production --no-progress",
    "lint:imports": "depcruise src packages/webview-contract/src --config .dependency-cruiser.cjs --output-type err"
  },
  "workspaces": [
    "packages/*",
    "webview_panels"
  ],
  "devDependencies": {
    "@e18e/eslint-plugin": "0.8.1",
    "@fusion-power-user/webview-contract": "*",
    "@rsbuild/core": "^2.2.8",
    "@types/mocha": "^10.0.10",
    "@types/node": ">=24.13.6 <24.19.0",
    "@types/vscode": "1.125.0",
    "@types/which": "^3.0.4",
    "@vitest/coverage-v8": "^5.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "dependency-cruiser": "^18.4.0",
    "eslint": "^10.11.0",
    "eslint-plugin-oxlint": "1.87.0",
    "eslint-plugin-sonarjs": "^4.2.1",
    "fast-check": "^4.10.2",
    "knip": "^6.38.0",
    "lockfile-lint": "^5.0.1",
    "mocha": "^12.0.2",
    "oxfmt": "0.73.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "npm:@typescript/typescript6@^6.0.0",
    "typescript-7": "npm:typescript@^7.0.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3",
    "vscode-uri": "^3.2.0"
  },
  "dependencies": {
    "vscode-languageclient": "10.1.2",
    "which": "^7.0.0",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "shell-quote": "^1.12.0",
    "@vscode/test-cli": {
      "mocha": "$mocha"
    },
    "@azure/msal-node": "^7.1.1"
  },
  "packageManager": "npm@11.19.0",
  "allowScripts": {
    "@vscode/vsce-sign@2.1.0": true,
    "fsevents@2.3.3": false
  }
}
