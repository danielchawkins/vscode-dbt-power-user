{
  "name": "fusion-power-user",
  "displayName": "Fusion Power User",
  "description": "An independent dbt Power User fork being rebuilt for local dbt Fusion development. Developer alpha; not yet local-only.",
  "icon": "media/images/dbt.png",
  "publisher": "danielchawkins",
  "license": "MIT",
  "homepage": "https://github.com/danielchawkins/vscode-dbt-power-user",
  "repository": {
    "type": "git",
    "url": "https://github.com/danielchawkins/vscode-dbt-power-user.git"
  },
  "bugs": {
    "url": "https://github.com/danielchawkins/vscode-dbt-power-user/issues"
  },
  "version": "0.8.1-beta.0",
  "type": "module",
  "engines": {
    "vscode": "^1.128.0",
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "capabilities": {
    "virtualWorkspaces": {
      "supported": false,
      "description": "Runs a local dbt executable."
    },
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Runs the dbt executable that workspace settings choose, so it stays disabled until the workspace is trusted."
    }
  },
  "categories": [
    "Other",
    "Programming Languages",
    "Snippets",
    "Data Science",
    "Formatters",
    "Testing"
  ],
  "keywords": [
    "dbt",
    "dbt fusion",
    "sql",
    "jinja-sql",
    "lsp"
  ],
  "activationEvents": [
    "workspaceContains:**/dbt_project.yml",
    "workspaceContains:**/dbt_project.yaml"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "taskDefinitions": [
      {
        "type": "dbt",
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "type": "string",
            "enum": [
              "run",
              "build",
              "test",
              "compile",
              "deps"
            ],
            "description": "The dbt subcommand to run."
          },
          "select": {
            "type": "string",
            "description": "The --select value, including any graph operators."
          },
          "project": {
            "type": "string",
            "description": "The dbt project root; optional when the workspace has one project."
          },
          "fullRefresh": {
            "type": "boolean",
            "description": "Pass --full-refresh to run or build."
          }
        }
      }
    ],
    "snippets": [
      {
        "language": "jinja-sql",
        "path": "./snippets/snippets_sql.json"
      }
    ],
    "configuration": [
      {
        "title": "Lineage",
        "properties": {
          "fusionPowerUser.lineage.defaultExpansion": {
            "type": "number",
            "description": "By default how much lineage should expand.",
            "default": 1
          },
          "fusionPowerUser.lineage.layer.tagPrefix": {
            "type": "string",
            "description": "A node tag starting with this prefix names the node's layer badge on lineage cards, for example `layer/staging`. Empty turns tags off.",
            "default": "layer/"
          },
          "fusionPowerUser.lineage.layer.inferFromPath": {
            "type": "boolean",
            "description": "Infer a lineage card's layer badge from a `staging`, `intermediate` or `marts` folder in the node's path, or a `stg_`, `int_`, `fct_` or `dim_` name prefix, when no tag names it.",
            "default": true
          },
          "fusionPowerUser.lineage.maxNeighbours": {
            "type": "integer",
            "minimum": 0,
            "description": "The most nodes one expansion draws; a `+N more` marker draws the rest on request. 0 draws every neighbour.",
            "default": 20
          },
          "fusionPowerUser.lineage.groupBy": {
            "type": "string",
            "enum": [
              "folder",
              "none"
            ],
            "enumDescriptions": [
              "An expansion with more new neighbours than `maxNeighbours` draws each folder of two or more as one group node.",
              "An over-cap expansion draws the first `maxNeighbours` cards and a `+N more` marker."
            ],
            "description": "How an expansion with more new neighbours than `maxNeighbours` is drawn.",
            "default": "folder"
          },
          "fusionPowerUser.lineage.layout": {
            "type": "string",
            "enum": [
              "layered",
              "leftToRight"
            ],
            "enumDescriptions": [
              "Parents above their children in layer bands (source, staging, intermediate, marts), with edges routed through the gaps between cards.",
              "Cards laid out left to right by dagre, with parents to the left of their children, bezier edges and no layer bands."
            ],
            "description": "How lineage cards are placed. Read-only in the panel, like the other lineage settings.",
            "default": "layered"
          },
          "fusionPowerUser.lineage.semanticZoom": {
            "type": "boolean",
            "description": "Below 50% zoom, lineage cards keep their size and show only a larger badge and title.",
            "default": true
          },
          "fusionPowerUser.lineage.title": {
            "type": "string",
            "enum": [
              "alias",
              "name"
            ],
            "enumDescriptions": [
              "Cards are titled by the name of the built relation: the model's alias when it has one.",
              "Cards are titled by the dbt name that `ref()` uses; the subtitle shows the alias when it differs."
            ],
            "description": "How lineage cards are titled.",
            "default": "alias"
          },
          "fusionPowerUser.lineage.layerColors": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "default": {},
            "markdownDescription": "A colour for a layer's band and card stripe, by layer tag: `source`, `staging`, `intermediate`, `marts`, `other`, or a custom layer. Use a theme colour id, such as `charts.red` or `terminal.ansiCyan`, so the colour follows the theme, or a CSS colour such as `#e06c75` or `oklch(70% 0.15 250)`. Layers left out use the theme's charts palette: source orange, staging blue, intermediate purple, marts green, other layers yellow."
          }
        }
      },
      {
        "title": "Fusion Power User",
        "properties": {
          "fusionPowerUser.enabled": {
            "type": "boolean",
            "description": "Enable Fusion Power User for this workspace folder.",
            "default": true,
            "scope": "resource"
          },
          "fusionPowerUser.projects": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "scope": "resource",
            "description": "Declared Project roots for this workspace folder: absolute, relative to the folder, or starting with ~. Supports ${workspaceFolder}, ${userHome}, and ${env:VAR}. When unset or empty, the folder root is served if it contains dbt_project.yml. Every configured root must contain dbt_project.yml or no declared roots are served for the folder."
          },
          "fusionPowerUser.staticAnalysis": {
            "type": "string",
            "enum": [
              "project",
              "off",
              "baseline",
              "strict"
            ],
            "enumDescriptions": [
              "Pass no mode to Fusion, so the project's own `+static_analysis` model config applies. To turn on strict for a project, add `models: <project name>: +static_analysis: strict` to dbt_project.yml.",
              "Ask Fusion to skip SQL analysis for the model and its descendants.",
              "Ask Fusion for Jinja, YAML, and SQL syntax diagnostics, ref and source navigation, table-level lineage, and ref autocomplete.",
              "Ask Fusion for baseline analysis plus SQL type and schema diagnostics, column hover and go-to-definition, column references, and alias rename."
            ],
            "default": "project",
            "scope": "resource",
            "description": "Static analysis mode passed to Fusion when this Declared Project's language server starts. Any value other than `project` overrides the project's own config."
          },
          "fusionPowerUser.dbtPath": {
            "type": "string",
            "scope": "resource",
            "description": "Path to the local dbt Fusion executable for this Declared Project. The extension will resolve this path first, then dbt on the extension host PATH. Absolute, relative to the workspace folder, or starting with ~. Supports ${workspaceFolder}, ${userHome}, and ${env:VAR}. An invalid configured path blocks that project's language server and does not fall back to PATH."
          },
          "fusionPowerUser.profilesDir": {
            "type": "string",
            "scope": "resource",
            "description": "Profiles directory passed to Fusion when this Declared Project's language server starts. Absolute, relative to the workspace folder, or starting with ~. Supports ${workspaceFolder}, ${userHome}, and ${env:VAR}. When unset, dbt's own search applies: DBT_PROFILES_DIR, then the project directory, then ~/.dbt."
          },
          "fusionPowerUser.toolEnvironment": {
            "type": "string",
            "enum": [
              "auto",
              "off"
            ],
            "default": "auto",
            "scope": "resource",
            "description": "Reads the project's mise or direnv environment, read-only, and applies it to dbt processes. It never trusts, installs or allows anything: run mise trust or direnv allow yourself."
          },
          "fusionPowerUser.target": {
            "type": "string",
            "scope": "resource",
            "description": "dbt target name passed to Fusion when this Declared Project's language server starts."
          },
          "fusionPowerUser.profile": {
            "type": "string",
            "scope": "resource",
            "description": "dbt profile name passed to Fusion as --profile when this Declared Project's language server starts. Corresponds to the official extension's dbt.profileName. Unset, Fusion takes the profile from dbt_project.yml or DBT_ENGINE_PROFILE."
          },
          "fusionPowerUser.lsp.compiledOutput": {
            "type": "string",
            "enum": [
              "separate",
              "shared"
            ],
            "enumDescriptions": [
              "The language server writes compiled SQL to target/.lsp/, so editing never overwrites what a dbt CLI run wrote.",
              "The language server writes compiled SQL to the same target/ as the dbt CLI, so each model has one compiled copy. An edit overwrites the last CLI output for that model."
            ],
            "default": "separate",
            "scope": "resource",
            "markdownDescription": "Where the language server writes compiled SQL. The `FUSION_POWER_USER_LSP_COMPILED_OUTPUT` environment variable, when set to `separate` or `shared`, overrides this for every project. A change restarts the project's language server."
          },
          "fusionPowerUser.lint.enabled": {
            "type": "boolean",
            "scope": "resource",
            "default": true,
            "description": "Whether Fusion lint diagnostics are enabled when this Declared Project's language server starts."
          },
          "fusionPowerUser.lsp.maxErrorReporting": {
            "type": "integer",
            "minimum": 1,
            "scope": "resource",
            "description": "The number of errors after which Fusion's language server stops analyzing this Declared Project. Unset keeps Fusion's own default."
          },
          "fusionPowerUser.trace.server": {
            "type": "string",
            "enum": [
              "off",
              "messages",
              "verbose"
            ],
            "enumDescriptions": [
              "Default Fusion server log level for this project.",
              "Pass debug log level to the Fusion server process and increase Fusion project log verbosity (for example logs/dbt.log).",
              "Pass trace log level to the Fusion server process and increase Fusion project log verbosity (for example logs/dbt.log)."
            ],
            "default": "off",
            "scope": "resource",
            "description": "Fusion server process log verbosity for this Declared Project. Server stdout and stderr appear in that project's \"Fusion Power User: <project>\" output channel; debug and verbose also increase Fusion's own project log file verbosity (for example logs/dbt.log)."
          },
          "fusionPowerUser.unquotedCaseInsensitiveIdentifierRegex": {
            "type": "string",
            "markdownDescription": "Regex to identify unquoted identifiers. Example: `^([_A-Z]+[_A-Z0-9$]*)$`"
          },
          "fusionPowerUser.run.additionalParams": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "description": "Add additional params to the dbt run model command. Ex: --select model1 --target prod needs to be added as four different entries \n--select \nmodel1 \n--target \nprod "
          },
          "fusionPowerUser.build.additionalParams": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "description": "Add additional params to the dbt build model command. Ex: --select model1 --target prod needs to be added as four different entries \n--select \nmodel1 \n--target \nprod "
          },
          "fusionPowerUser.test.additionalParams": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "description": "Add additional params to the dbt test model command. Ex: --select model1 --target prod needs to be added as four different entries \n--select \nmodel1 \n--target \nprod "
          },
          "fusionPowerUser.query.limit": {
            "type": "integer",
            "description": "The maximum number of rows the `Preview SQL Query` command returns.",
            "default": 500,
            "minimum": 1
          },
          "fusionPowerUser.generateModel.fileNameTemplate": {
            "type": "string",
            "enum": [
              "{prefix}_{sourceName}_{tableName}",
              "{prefix}_{sourceName}__{tableName}",
              "{prefix}_{tableName}",
              "{tableName}"
            ],
            "default": "{prefix}_{sourceName}_{tableName}",
            "description": "Set the naming template that is used when generating a model from a source yml file."
          },
          "fusionPowerUser.generateModel.prefix": {
            "type": "string",
            "default": "base",
            "description": "Set the prefix that is used when generating a model from a source yml file."
          },
          "fusionPowerUser.defer.perProject": {
            "type": "object",
            "description": "Per project, keyed by its path relative to the workspace folder: defer run, build, test, compile, show and inline compile to a production manifest on disk. With no entry for a project the extension passes no defer flags, so dbt's own default applies (DBT_DEFER and DBT_STATE in the environment, else no deferral); an entry with deferToProduction false passes --no-defer.",
            "scope": "resource",
            "patternProperties": {
              ".*": {
                "type": "object",
                "properties": {
                  "deferToProduction": {
                    "type": "boolean",
                    "description": "Run subset of models without building their parent models",
                    "default": false
                  },
                  "manifestPathForDeferral": {
                    "type": "string",
                    "description": "Directory containing the deferral manifest.json (or the manifest.json path)",
                    "default": ""
                  },
                  "favorState": {
                    "type": "boolean",
                    "description": "If a given model exists in both the current environment and the defined defer state, turn this flag on to use the latter always",
                    "default": false
                  }
                }
              }
            }
          },
          "fusionPowerUser.perProject": {
            "type": "object",
            "scope": "resource",
            "description": "Settings for one Declared Project, keyed by its path relative to the workspace folder (for example `transformation/dbt/finance_general`). Each entry overrides the folder's fusionPowerUser setting of the same name for that project only; a setting the entry omits keeps the folder's value.",
            "default": {},
            "patternProperties": {
              ".*": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "staticAnalysis": {
                    "type": "string",
                    "enum": [
                      "project",
                      "off",
                      "baseline",
                      "strict"
                    ],
                    "enumDescriptions": [
                      "Pass no mode to Fusion, so the project's own `+static_analysis` model config applies. To turn on strict for a project, add `models: <project name>: +static_analysis: strict` to dbt_project.yml.",
                      "Ask Fusion to skip SQL analysis for the model and its descendants.",
                      "Ask Fusion for Jinja, YAML, and SQL syntax diagnostics, ref and source navigation, table-level lineage, and ref autocomplete.",
                      "Ask Fusion for baseline analysis plus SQL type and schema diagnostics, column hover and go-to-definition, column references, and alias rename."
                    ],
                    "description": "This project's fusionPowerUser.staticAnalysis; overrides the folder's value."
                  },
                  "dbtPath": {
                    "type": "string",
                    "description": "This project's fusionPowerUser.dbtPath; overrides the folder's value."
                  },
                  "profilesDir": {
                    "type": "string",
                    "description": "This project's fusionPowerUser.profilesDir; overrides the folder's value."
                  },
                  "profile": {
                    "type": "string",
                    "description": "This project's fusionPowerUser.profile; overrides the folder's value."
                  },
                  "target": {
                    "type": "string",
                    "description": "This project's fusionPowerUser.target; overrides the folder's value."
                  },
                  "lint.enabled": {
                    "type": "boolean",
                    "description": "This project's fusionPowerUser.lint.enabled; overrides the folder's value."
                  },
                  "lsp.maxErrorReporting": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "This project's fusionPowerUser.lsp.maxErrorReporting; overrides the folder's value."
                  },
                  "trace.server": {
                    "type": "string",
                    "enum": [
                      "off",
                      "messages",
                      "verbose"
                    ],
                    "enumDescriptions": [
                      "Default Fusion server log level for this project.",
                      "Pass debug log level to the Fusion server process and increase Fusion project log verbosity (for example logs/dbt.log).",
                      "Pass trace log level to the Fusion server process and increase Fusion project log verbosity (for example logs/dbt.log)."
                    ],
                    "description": "This project's fusionPowerUser.trace.server; overrides the folder's value."
                  },
                  "lsp.compiledOutput": {
                    "type": "string",
                    "enum": [
                      "separate",
                      "shared"
                    ],
                    "enumDescriptions": [
                      "The language server writes compiled SQL to target/.lsp/, so editing never overwrites what a dbt CLI run wrote.",
                      "The language server writes compiled SQL to the same target/ as the dbt CLI, so each model has one compiled copy. An edit overwrites the last CLI output for that model."
                    ],
                    "description": "This project's fusionPowerUser.lsp.compiledOutput; overrides the folder's value."
                  }
                }
              }
            }
          }
        }
      }
    ],
