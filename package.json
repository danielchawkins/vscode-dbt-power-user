      },
      {
        "command": "fusionPowerUser.configureFileAssociations",
        "title": "Configure dbt file associations",
        "category": "Fusion Power User"
      },
      {
        "command": "fusionPowerUser.applyDeferConfig",
        "category": "Fusion Power User",
        "title": "Apply defer configuration"
      }
    ],
    "keybindings": [
      {
        "key": "Ctrl+Enter",
        "mac": "Cmd+Enter",
        "command": "fusionPowerUser.executeSQL",
        "when": "editorFocus && resourceLangId =~ /^sql$|^jinja-sql$/"
      },
      {
        "key": "Ctrl+'",
        "mac": "Cmd+'",
        "command": "fusionPowerUser.sqlPreview"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "fusionPowerUser.executeSQL",
          "when": "resourceLangId =~ /^sql$|^jinja-sql$/",
          "group": "navigation@1"
        },
        {
          "command": "fusionPowerUser.runCurrentModel",
          "when": "resourceLangId =~ /^sql$|^jinja-sql$/",
          "group": "navigation@3"
        },
        {
          "command": "fusionPowerUser.testCurrentModel",
          "when": "resourceLangId =~ /^sql$|^jinja-sql$/",
          "group": "navigation@4"
        },
        {
          "command": "fusionPowerUser.sqlPreview",
          "when": "resourceLangId =~ /^sql$|^jinja-sql$/",
          "group": "navigation@5"
        }
      ],
      "editor/context": [
        {
          "submenu": "fusionPowerUser.editorContext",
          "group": "dbt@1",
          "when": "resourceLangId =~ /^sql$|^jinja-sql$/"
        }
      ],
      "fusionPowerUser.editorContext": [
        {
          "command": "fusionPowerUser.runCurrentModel",
          "group": "1_run@1"
        },
        {
          "command": "fusionPowerUser.testCurrentModel",
          "group": "1_run@2"
        },
        {
          "submenu": "fusionPowerUser.buildModel",
          "group": "1_run@3"
        },
        {
          "command": "fusionPowerUser.compileCurrentModel",
          "group": "2_compile@1"
        },
        {
          "command": "fusionPowerUser.showCompiledSQL",
          "group": "2_compile@2"
        },
        {
          "command": "fusionPowerUser.goToDocumentationEditor",
          "group": "3_docs@1"
        }
      ],
      "editor/title/run": [
        {
          "command": "fusionPowerUser.buildCurrentProject",
          "when": "resourceLangId =~ /^sql$|^jinja-sql$/",
          "group": "inline"
        },
        {
          "command": "fusionPowerUser.buildCurrentModel",
          "when": "resourceLangId =~ /^sql$|^jinja-sql$/",
          "group": "inline"
        },
        {
          "command": "fusionPowerUser.buildChildrenModels",
          "when": "resourceLangId =~ /^sql$|^jinja-sql$/",
          "group": "inline"
        },
        {
          "command": "fusionPowerUser.buildParentModels",
          "when": "resourceLangId =~ /^sql$|^jinja-sql$/",
          "group": "inline"
        },
        {
          "command": "fusionPowerUser.buildChildrenParentModels",
          "when": "resourceLangId =~ /^sql$|^jinja-sql$/",
          "group": "inline"
        },
        {
          "command": "fusionPowerUser.runCurrentModel",
          "when": "resourceLangId =~ /^sql$|^jinja-sql$/",
          "group": "inline"
        },
        {
          "command": "fusionPowerUser.cleanCurrentProject",
          "when": "resourceLangId =~ /^sql$|^jinja-sql$/",
          "group": "inline"
        }
      ],
      "view/title": [
        {
          "command": "fusionPowerUser.testCurrentModel",
          "when": "view == model_test_treeview",
          "group": "navigation"
        },
        {
          "command": "fusionPowerUser.runChildrenModels",
          "when": "view == children_model_treeview",
          "group": "navigation"
        },
        {
          "command": "fusionPowerUser.runParentModels",
          "when": "view == parent_model_treeview",
          "group": "navigation"
        },
        {
          "command": "fusionPowerUser.clearRunHistory",
          "when": "view == run_history_treeview",
          "group": "2_clear"
        }
      ],
      "view/item/context": [
        {
          "command": "fusionPowerUser.rerunFromHistory",
          "when": "view == run_history_treeview && viewItem == runHistoryEntry",
          "group": "inline"
        },
        {
          "command": "fusionPowerUser.runTest",
          "when": "view == model_test_treeview && viewItem != source",
          "group": "inline"
        },
        {
          "command": "fusionPowerUser.runChildrenModels",
          "when": "view == children_model_treeview && viewItem != source",
          "group": "inline"
        },
        {
          "command": "fusionPowerUser.runParentModels",
          "when": "view == parent_model_treeview && viewItem != source",
          "group": "inline"
        },
        {
          "command": "fusionPowerUser.copyModelName",
          "when": "(view == parent_model_treeview || view ==  children_model_treeview || view == documentation_treeview) && viewItem != source",
          "group": "navigation"
        },
        {
          "command": "fusionPowerUser.goToDocumentationEditor",
          "when": "view == documentation_treeview",
          "group": "inline"
        }
      ],
      "fusionPowerUser.buildModel": [
        {
          "command": "fusionPowerUser.buildCurrentModel",
          "when": "resourceLangId =~ /^sql$|^jinja-sql$/",
          "group": "inline"
        },
        {
          "command": "fusionPowerUser.buildChildrenModels",
          "when": "resourceLangId =~ /^sql$|^jinja-sql$/",
          "group": "inline"
        },
        {
          "command": "fusionPowerUser.buildParentModels",
          "when": "resourceLangId =~ /^sql$|^jinja-sql$/",
          "group": "inline"
        },
        {
          "command": "fusionPowerUser.buildChildrenParentModels",
          "when": "resourceLangId =~ /^sql$|^jinja-sql$/",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "fusionPowerUser.rerunFromHistory",
          "when": "false"
        },
        {
          "command": "fusionPowerUser.copyModelName",
          "when": "false"
        }
      ]
    },
    "submenus": [
      {
        "id": "fusionPowerUser.editorContext",
        "label": "dbt"
      },
      {
        "id": "fusionPowerUser.buildModel",
        "label": "Build dbt Model",
        "icon": {
          "light": "./media/images/build-model_light.svg",
          "dark": "./media/images/build-model_dark.svg"
        }
      }
    ],
    "languages": [
      {
        "id": "jinja-sql",
        "icon": {
          "light": "./media/images/dbt_file_icon.svg",
          "dark": "./media/images/dbt_file_icon.svg"
        },
        "filenamePatterns": [
          "**/models/**/*.sql",
          "**/macros/**/*.sql",
          "**/snapshots/**/*.sql",
          "**/analyses/**/*.sql",
          "**/tests/**/*.sql",
          "**/dbt_packages/**/*.sql"
        ]
      },
      {
        "id": "sql",
        "filenamePatterns": [
