{
  "name": "fusion-power-user",
  "displayName": "Fusion Power User",
  "description": "An independent dbt Power User fork being rebuilt for local dbt Fusion development. Developer alpha; not yet local-only.",
  "icon": "media/images/dbt.png",
  "publisher": "danielchawkins",
  "license": "MIT",
  "homepage": "https://github.com/danielchawkins/vscode-dbt-power-user",
  "repository": {
    "type": "git",
    "url": "https://github.com/danielchawkins/vscode-dbt-power-user.git"
  },
  "bugs": {
    "url": "https://github.com/danielchawkins/vscode-dbt-power-user/issues"
  },
  "version": "0.4.0-beta.1",
  "type": "module",
  "engines": {
    "vscode": "^1.128.0",
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "capabilities": {
    "hoverProvider": true
  },
  "categories": [
    "Other",
    "Programming Languages",
    "Snippets",
    "Data Science",
    "Formatters",
    "Testing"
  ],
  "keywords": [
    "dbt",
    "dbt fusion",
    "sql",
    "jinja-sql",
    "lsp"
  ],
  "activationEvents": [
    "workspaceContains:**/dbt_project.yml"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "snippets": [
      {
        "language": "jinja-sql",
        "path": "./snippets/snippets_sql.json"
      }
    ],
    "configuration": [
      {
        "title": "Lineage",
        "properties": {
          "fusionPowerUser.lineage.defaultExpansion": {
            "type": "number",
            "description": "By default how much lineage should expand.",
            "default": 1
          }
        }
      },
      {
        "title": "Fusion Power User",
        "properties": {
          "fusionPowerUser.enabled": {
            "type": "boolean",
            "description": "Enable Fusion Power User for this workspace folder.",
            "default": true,
            "scope": "resource"
          },
          "fusionPowerUser.projects": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "scope": "resource",
            "description": "Declared Project roots for this workspace folder, relative to the folder or absolute. When unset or empty, the folder root is served if it contains dbt_project.yml. Every configured root must contain dbt_project.yml or no declared roots are served for the folder."
          },
          "fusionPowerUser.staticAnalysis": {
            "type": "string",
            "enum": [
              "project",
              "off",
              "baseline",
              "strict"
            ],
            "enumDescriptions": [
              "Pass no mode to Fusion, so the project's own `+static_analysis` model config applies. To turn on strict for a project, add `models: <project name>: +static_analysis: strict` to dbt_project.yml.",
              "Ask Fusion to skip SQL analysis for the model and its descendants.",
              "Ask Fusion for Jinja, YAML, and SQL syntax diagnostics, ref and source navigation, table-level lineage, and ref autocomplete.",
              "Ask Fusion for baseline analysis plus SQL type and schema diagnostics, column hover and go-to-definition, column references, and alias rename."
            ],
            "default": "project",
            "scope": "resource",
            "description": "Static analysis mode passed to Fusion when this Declared Project's language server starts. Any value other than `project` overrides the project's own config."
          },
          "fusionPowerUser.dbtPath": {
            "type": "string",
            "scope": "resource",
            "description": "Path to the local dbt Fusion executable for this Declared Project. The extension will resolve this path first, then dbt on the extension host PATH. Supports ${workspaceFolder}, ${userHome}, and ${env:VAR}. An invalid configured path blocks that project's language server and does not fall back to PATH."
          },
          "fusionPowerUser.profilesDir": {
            "type": "string",
            "scope": "resource",
            "description": "Profiles directory passed to Fusion when this Declared Project's language server starts. Supports ${workspaceFolder}, ${userHome}, and ${env:VAR}. Relative paths resolve against the containing workspace folder."
          },
          "fusionPowerUser.target": {
            "type": "string",
            "scope": "resource",
            "description": "dbt target name passed to Fusion when this Declared Project's language server starts."
          },
          "fusionPowerUser.lsp.compiledOutput": {
            "type": "string",
            "enum": [
              "separate",
              "shared"
            ],
            "enumDescriptions": [
              "The language server writes compiled SQL to target/.lsp/, so editing never overwrites what a dbt CLI run wrote.",
              "The language server writes compiled SQL to the same target/ as the dbt CLI, so each model has one compiled copy. An edit overwrites the last CLI output for that model."
            ],
            "default": "separate",
            "scope": "resource",
            "markdownDescription": "Where the language server writes compiled SQL. The `FUSION_POWER_USER_LSP_COMPILED_OUTPUT` environment variable, when set to `separate` or `shared`, overrides this for every project. A change restarts the project's language server."
          },
          "fusionPowerUser.lint.enabled": {
            "type": "boolean",
            "scope": "resource",
            "default": true,
            "description": "Whether Fusion lint diagnostics are enabled when this Declared Project's language server starts."
          },
          "fusionPowerUser.trace.server": {
            "type": "string",
            "enum": [
              "off",
              "messages",
              "verbose"
            ],
            "enumDescriptions": [
              "Default Fusion server log level for this project.",
              "Pass debug log level to the Fusion server process and increase Fusion project log verbosity (for example logs/dbt.log).",
              "Pass trace log level to the Fusion server process and increase Fusion project log verbosity (for example logs/dbt.log)."
            ],
            "default": "off",
            "scope": "resource",
            "description": "Fusion server process log verbosity for this Declared Project. Server stdout and stderr appear in that project's Fusion LSP output channel; debug and verbose also increase Fusion's own project log file verbosity (for example logs/dbt.log)."
          },
          "fusionPowerUser.unquotedCaseInsensitiveIdentifierRegex": {
            "type": "string",
            "markdownDescription": "Regex to identify unquoted identifiers. Example: `^([_A-Z]+[_A-Z0-9$]*)$`"
          },
          "fusionPowerUser.run.additionalParams": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "description": "Add additional params to the dbt run model command. Ex: --select model1 --target prod needs to be added as four different entries \n--select \nmodel1 \n--target \nprod "
          },
          "fusionPowerUser.build.additionalParams": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "description": "Add additional params to the dbt build model command. Ex: --select model1 --target prod needs to be added as four different entries \n--select \nmodel1 \n--target \nprod "
          },
          "fusionPowerUser.test.additionalParams": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "description": "Add additional params to the dbt test model command. Ex: --select model1 --target prod needs to be added as four different entries \n--select \nmodel1 \n--target \nprod "
          },
          "fusionPowerUser.query.limit": {
            "type": "integer",
            "description": "The maximum number of rows the `Preview SQL Query` command returns.",
            "default": 500,
            "minimum": 1
          },
          "fusionPowerUser.queryResults.theme": {
            "type": "string",
            "description": "Theme for perspective viewer in query results panel",
            "default": "Vintage",
            "enum": [
              "Vintage",
              "Pro Light",
              "Pro Dark",
              "Vaporwave",
              "Solarized",
              "Solarized Dark",
              "Monokai"
            ]
          },
          "fusionPowerUser.query.template": {
            "type": "string",
            "description": "Override the default query template that is used by the `Preview SQL Query` command. Use this if your database has special syntax to limit query results",
            "default": "select * from ({query}\n) as query limit {limit}"
          },
          "fusionPowerUser.generateModel.fileNameTemplate": {
            "type": "string",
            "enum": [
              "{prefix}_{sourceName}_{tableName}",
              "{prefix}_{sourceName}__{tableName}",
              "{prefix}_{tableName}",
              "{tableName}"
            ],
            "default": "{prefix}_{sourceName}_{tableName}",
            "description": "Set the naming template that is used when generating a model from a source yml file."
          },
          "fusionPowerUser.generateModel.prefix": {
            "type": "string",
            "default": "base",
            "description": "Set the prefix that is used when generating a model from a source yml file."
          },
          "fusionPowerUser.defer.perProject": {
            "type": "object",
            "description": "Run subset of models without building their parent models",
            "scope": "resource",
            "patternProperties": {
              ".*": {
                "type": "object",
                "properties": {
                  "deferToProduction": {
                    "type": "boolean",
                    "description": "Run subset of models without building their parent models",
                    "default": false
                  },
                  "manifestPathForDeferral": {
                    "type": "string",
                    "description": "Directory containing the deferral manifest.json (or the manifest.json path)",
                    "default": ""
                  },
                  "favorState": {
                    "type": "boolean",
                    "description": "If a given model exists in both the current environment and the defined defer state, turn this flag on to use the latter always",
                    "default": false
                  }
                }
              }
            }
          }
        }
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dbt_view",
          "title": "Fusion Power User",
          "icon": "./media/images/dbt_icon.svg",
          "contextualTitle": "Fusion Power User"
        }
      ],
      "panel": [
        {
          "id": "dbt_preview_results",
          "title": "Query Results",
          "icon": "./media/images/dbt_icon.svg"
        },
        {
          "id": "lineage_view",
          "title": "Lineage",
          "icon": "./media/images/dbt_icon.svg"
        },
        {
          "id": "docs_edit_view",
          "title": "Documentation Editor",
          "icon": "./media/images/dbt_icon.svg"
        },
        {
          "id": "run_history_view",
          "title": "Run History",
          "icon": "./media/images/dbt_icon.svg"
        }
      ]
    },
    "views": {
      "dbt_view": [
        {
          "id": "model_test_treeview",
          "name": "Model Tests"
        },
        {
          "id": "parent_model_treeview",
          "name": "Parent Models"
        },
        {
          "id": "children_model_treeview",
          "name": "Children Models"
        },
        {
          "id": "documentation_treeview",
          "name": "Documentation"
        }
      ],
      "dbt_preview_results": [
        {
          "id": "fusionPowerUser.PreviewResults",
          "name": "",
          "type": "webview"
        }
      ],
      "lineage_view": [
        {
          "id": "fusionPowerUser.Lineage",
          "name": "",
          "type": "webview"
        }
      ],
      "docs_edit_view": [
        {
          "id": "fusionPowerUser.DocsEdit",
          "name": "",
          "type": "webview"
        }
      ],
      "run_history_view": [
        {
          "id": "run_history_treeview",
          "name": "Runs"
        }
      ]
    },
    "commands": [
      {
        "command": "fusionPowerUser.viewInDocEditor",
        "title": "View in documentation editor",
        "category": "Fusion Power User"
      },
      {
        "command": "fusionPowerUser.runCurrentModel",
        "title": "Run dbt Model",
        "category": "Fusion Power User",
        "icon": {
          "light": "./media/images/run-light.svg",
          "dark": "./media/images/run-dark.svg"
        }
      },
      {
        "command": "fusionPowerUser.rerunFromHistory",
        "title": "Re-run Command",
        "category": "Fusion Power User",
        "icon": "$(debug-rerun)"
      },
      {
        "command": "fusionPowerUser.clearRunHistory",
        "title": "Clear Run History",
        "category": "Fusion Power User",
        "icon": "$(clear-all)"
      },
      {
        "command": "fusionPowerUser.profileCtes",
        "title": "Profile CTEs",
        "category": "Fusion Power User"
      },
      {
        "command": "fusionPowerUser.cancelCteProfiling",
        "title": "Cancel CTE Profiling",
        "category": "Fusion Power User"
      },
      {
        "command": "fusionPowerUser.clearProfileResults",
        "title": "Clear CTE Profile Results",
        "category": "Fusion Power User",
        "icon": "$(clear-all)"
      },
      {
        "command": "fusionPowerUser.toggleProfileDecorations",
        "title": "Toggle CTE Profile Decorations",
        "category": "Fusion Power User"
      },
      {
        "command": "fusionPowerUser.validateProject",
        "title": "Validate dbt Project",
        "category": "Fusion Power User"
      },
      {
        "command": "fusionPowerUser.installDeps",
        "title": "Install dbt Package Dependencies",
        "category": "Fusion Power User"
      },
      {
        "command": "fusionPowerUser.enableStrictAnalysis",
        "title": "Enable Strict Static Analysis in dbt_project.yml",
        "category": "Fusion Power User"
      },
      {
        "command": "fusionPowerUser.addSchemaOriginHook",
        "title": "Add Source Schema-Origin Hook to dbt_project.yml",
        "category": "Fusion Power User"
      },
      {
        "command": "fusionPowerUser.refreshColumnLineage",
