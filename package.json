{
  "name": "fusion-power-user",
  "displayName": "Fusion Power User",
  "description": "An independent dbt Power User fork being rebuilt for local dbt Fusion development. Developer alpha; not yet local-only.",
  "icon": "media/images/dbt.png",
  "publisher": "danielchawkins",
  "license": "MIT",
  "homepage": "https://github.com/danielchawkins/vscode-dbt-power-user",
  "repository": {
    "type": "git",
    "url": "https://github.com/danielchawkins/vscode-dbt-power-user.git"
  },
  "bugs": {
    "url": "https://github.com/danielchawkins/vscode-dbt-power-user/issues"
  },
  "version": "0.2.0-alpha.0",
  "type": "module",
  "engines": {
    "vscode": "^1.128.0",
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "capabilities": {
    "hoverProvider": true
  },
  "categories": [
    "Other",
    "Programming Languages",
    "Snippets",
    "Data Science",
    "Formatters",
    "Testing"
  ],
  "keywords": [
    "dbt",
    "dbt fusion",
    "sql",
    "jinja-sql",
    "lsp"
  ],
  "activationEvents": [
    "workspaceContains:**/dbt_project.yml"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "snippets": [
      {
        "language": "jinja-sql",
        "path": "./snippets/snippets_sql.json"
      }
    ],
    "configuration": [
      {
        "title": "Lineage",
        "properties": {
          "fusionPowerUser.lineage.defaultExpansion": {
            "type": "number",
            "description": "By default how much lineage should expand.",
            "default": 1
          }
        }
      },
      {
        "title": "Fusion Power User",
        "properties": {
          "fusionPowerUser.enabled": {
            "type": "boolean",
            "description": "Enable Fusion Power User for this workspace folder.",
            "default": true,
            "scope": "resource"
          },
          "fusionPowerUser.projects": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "scope": "resource",
            "description": "Declared Project roots for this workspace folder, relative to the folder or absolute. When unset or empty, the folder root is served if it contains dbt_project.yml. Every configured root must contain dbt_project.yml or no declared roots are served for the folder."
          },
          "fusionPowerUser.staticAnalysis": {
            "type": "string",
            "enum": [
              "off",
              "baseline",
              "strict"
            ],
            "enumDescriptions": [
              "Ask Fusion to skip SQL analysis for the model and its descendants.",
              "Ask Fusion for Jinja, YAML, and SQL syntax diagnostics, ref and source navigation, table-level lineage, and ref autocomplete.",
              "Ask Fusion for baseline analysis plus column-level lineage, SQL type and schema diagnostics, column go-to-definition, select-star hover, and column rename when the local project and warehouse profile support them."
            ],
            "default": "baseline",
            "scope": "resource",
            "description": "Static analysis depth passed to Fusion when this Declared Project's language server starts."
          },
          "fusionPowerUser.dbtPath": {
            "type": "string",
            "scope": "resource",
            "description": "Path to the local dbt Fusion executable for this Declared Project. The extension will resolve this path first, then dbt on the extension host PATH. Supports ${workspaceFolder}, ${userHome}, and ${env:VAR}. An invalid configured path blocks that project's language server and does not fall back to PATH."
          },
          "fusionPowerUser.profilesDir": {
            "type": "string",
            "scope": "resource",
            "description": "Profiles directory passed to Fusion when this Declared Project's language server starts. Supports ${workspaceFolder}, ${userHome}, and ${env:VAR}. Relative paths resolve against the containing workspace folder."
          },
          "fusionPowerUser.target": {
            "type": "string",
            "scope": "resource",
            "description": "dbt target name passed to Fusion when this Declared Project's language server starts."
          },
          "fusionPowerUser.lint.enabled": {
            "type": "boolean",
            "scope": "resource",
            "default": true,
            "description": "Whether Fusion lint diagnostics are enabled when this Declared Project's language server starts."
          },
          "fusionPowerUser.trace.server": {
            "type": "string",
            "enum": [
              "off",
              "messages",
              "verbose"
            ],
            "enumDescriptions": [
              "Default Fusion server log level for this project.",
              "Pass debug log level to the Fusion server process and increase Fusion project log verbosity (for example logs/dbt.log).",
              "Pass trace log level to the Fusion server process and increase Fusion project log verbosity (for example logs/dbt.log)."
            ],
            "default": "off",
            "scope": "resource",
            "description": "Fusion server process log verbosity for this Declared Project. Server stdout and stderr appear in that project's Fusion LSP output channel; debug and verbose also increase Fusion's own project log file verbosity (for example logs/dbt.log)."
          },
          "fusionPowerUser.unquotedCaseInsensitiveIdentifierRegex": {
            "type": "string",
            "markdownDescription": "Regex to identify unquoted identifiers. Example: `^([_A-Z]+[_A-Z0-9$]*)$`"
          },
          "fusionPowerUser.run.additionalParams": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "description": "Add additional params to the dbt run model command. Ex: --select model1 --target prod needs to be added as four different entries \n--select \nmodel1 \n--target \nprod "
          },
          "fusionPowerUser.build.additionalParams": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "description": "Add additional params to the dbt build model command. Ex: --select model1 --target prod needs to be added as four different entries \n--select \nmodel1 \n--target \nprod "
          },
          "fusionPowerUser.test.additionalParams": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "description": "Add additional params to the dbt test model command. Ex: --select model1 --target prod needs to be added as four different entries \n--select \nmodel1 \n--target \nprod "
          },
          "fusionPowerUser.query.limit": {
            "type": "integer",
            "description": "The maximum number of rows the `Preview SQL Query` command returns.",
            "default": 500,
            "minimum": 1
          },
          "fusionPowerUser.queryResults.theme": {
            "type": "string",
            "description": "Theme for perspective viewer in query results panel",
            "default": "Vintage",
            "enum": [
              "Vintage",
              "Pro Light",
              "Pro Dark",
              "Vaporwave",
              "Solarized",
              "Solarized Dark",
              "Monokai"
            ]
          },
          "fusionPowerUser.query.template": {
            "type": "string",
            "description": "Override the default query template that is used by the `Preview SQL Query` command. Use this if your database has special syntax to limit query results",
            "default": "select * from ({query}\n) as query limit {limit}"
          },
          "fusionPowerUser.generateModel.fileNameTemplate": {
            "type": "string",
            "enum": [
              "{prefix}_{sourceName}_{tableName}",
              "{prefix}_{sourceName}__{tableName}",
              "{prefix}_{tableName}",
              "{tableName}"
            ],
            "default": "{prefix}_{sourceName}_{tableName}",
            "description": "Set the naming template that is used when generating a model from a source yml file."
          },
          "fusionPowerUser.generateModel.prefix": {
            "type": "string",
            "default": "base",
            "description": "Set the prefix that is used when generating a model from a source yml file."
          },
          "fusionPowerUser.defer.perProject": {
            "type": "object",
            "description": "Run subset of models without building their parent models",
            "scope": "resource",
            "patternProperties": {
              ".*": {
                "type": "object",
                "properties": {
                  "deferToProduction": {
                    "type": "boolean",
                    "description": "Run subset of models without building their parent models",
                    "default": false
                  },
                  "manifestPathForDeferral": {
                    "type": "string",
                    "description": "Directory containing the deferral manifest.json (or the manifest.json path)",
                    "default": ""
                  },
                  "favorState": {
                    "type": "boolean",
                    "description": "If a given model exists in both the current environment and the defined defer state, turn this flag on to use the latter always",
                    "default": false
                  }
                }
              }
            }
          }
        }
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dbt_view",
          "title": "Fusion Power User",
          "icon": "./media/images/dbt_icon.svg",
          "contextualTitle": "Fusion Power User"
        }
      ],
      "panel": [
        {
          "id": "dbt_preview_results",
          "title": "Query Results",
          "icon": "./media/images/dbt_icon.svg"
        },
        {
          "id": "lineage_view",
          "title": "Lineage",
          "icon": "./media/images/dbt_icon.svg"
        },
        {
          "id": "docs_edit_view",
          "title": "Documentation Editor",
          "icon": "./media/images/dbt_icon.svg"
        },
        {
          "id": "run_history_view",
          "title": "Run History",
          "icon": "./media/images/dbt_icon.svg"
        }
      ]
    },
    "views": {
      "dbt_view": [
        {
          "id": "model_test_treeview",
          "name": "Model Tests"
        },
        {
          "id": "parent_model_treeview",
          "name": "Parent Models"
        },
        {
          "id": "children_model_treeview",
          "name": "Children Models"
        },
        {
          "id": "documentation_treeview",
          "name": "Documentation"
        }
      ],
      "dbt_preview_results": [
        {
          "id": "fusionPowerUser.PreviewResults",
          "name": "",
          "type": "webview"
        }
      ],
      "lineage_view": [
        {
          "id": "fusionPowerUser.Lineage",
          "name": "",
          "type": "webview"
        }
      ],
      "docs_edit_view": [
        {
          "id": "fusionPowerUser.DocsEdit",
          "name": "",
          "type": "webview"
        }
      ],
      "run_history_view": [
        {
          "id": "run_history_treeview",
          "name": "Runs"
        }
      ]
    },
    "commands": [
      {
        "command": "fusionPowerUser.viewInDocEditor",
        "title": "View in documentation editor",
        "category": "Fusion Power User"
      },
      {
        "command": "fusionPowerUser.runCurrentModel",
        "title": "Run dbt Model",
        "category": "Fusion Power User",
        "icon": {
          "light": "./media/images/run-light.svg",
          "dark": "./media/images/run-dark.svg"
        }
      },
      {
        "command": "fusionPowerUser.rerunFromHistory",
        "title": "Re-run Command",
        "category": "Fusion Power User",
        "icon": "$(debug-rerun)"
      },
      {
        "command": "fusionPowerUser.clearRunHistory",
        "title": "Clear Run History",
        "category": "Fusion Power User",
        "icon": "$(clear-all)"
      },
      {
        "command": "fusionPowerUser.profileCtes",
        "title": "Profile CTEs",
        "category": "Fusion Power User"
      },
      {
        "command": "fusionPowerUser.cancelCteProfiling",
        "title": "Cancel CTE Profiling",
        "category": "Fusion Power User"
      },
      {
        "command": "fusionPowerUser.clearProfileResults",
        "title": "Clear CTE Profile Results",
        "category": "Fusion Power User",
        "icon": "$(clear-all)"
      },
      {
        "command": "fusionPowerUser.toggleProfileDecorations",
        "title": "Toggle CTE Profile Decorations",
        "category": "Fusion Power User"
      },
      {
        "command": "fusionPowerUser.validateProject",
        "title": "Validate dbt Project",
        "category": "Fusion Power User"
      },
      {
        "command": "fusionPowerUser.installDeps",
        "title": "Install dbt Package Dependencies",
        "category": "Fusion Power User"
      },
      {
        "command": "fusionPowerUser.compileCurrentModel",
        "title": "Compile dbt Model",
        "category": "Fusion Power User",
        "icon": {
          "light": "./media/images/build_light.svg",
          "dark": "./media/images/build_dark.svg"
        }
      },
      {
        "command": "fusionPowerUser.sqlPreview",
        "title": "Compiled dbt Preview",
        "category": "Fusion Power User",
        "icon": "$(diff)"
      },
      {
        "command": "fusionPowerUser.runTest",
        "title": "Run Test",
        "category": "Fusion Power User",
        "icon": "$(pass)"
      },
      {
        "command": "fusionPowerUser.testCurrentModel",
        "title": "Test dbt Model",
        "category": "Fusion Power User",
        "icon": "$(pass)"
      },
      {
        "command": "fusionPowerUser.runChildrenModels",
        "title": "Run Downstream Models",
        "category": "Fusion Power User",
        "icon": "$(run-below)"
      },
      {
        "command": "fusionPowerUser.runParentModels",
        "title": "Run Upstream Models",
        "category": "Fusion Power User",
        "icon": "$(run-above)"
      },
      {
        "command": "fusionPowerUser.copyModelName",
        "title": "Copy model name to clipboard",
        "category": "Fusion Power User"
      },
      {
        "command": "fusionPowerUser.showRunSQL",
        "title": "Open dbt target folder run SQL",
        "category": "Fusion Power User",
        "icon": {
          "light": "./media/images/file-code_light.svg",
          "dark": "./media/images/file-code_dark.svg"
        }
      },
      {
        "command": "fusionPowerUser.generateSchemaYML",
        "title": "Generate Documentation YML",
        "category": "Fusion Power User",
        "icon": {
          "light": "./media/images/file-code_light.svg",
          "dark": "./media/images/file-code_dark.svg"
        }
      },
      {
        "command": "fusionPowerUser.goToDocumentationEditor",
        "title": "Open Documentation Editor",
        "category": "Fusion Power User",
        "icon": {
          "light": "./media/images/file-code_light.svg",
          "dark": "./media/images/file-code_dark.svg"
        }
      },
      {
        "command": "fusionPowerUser.showCompiledSQL",
        "title": "Open dbt target folder compiled SQL",
        "category": "Fusion Power User",
        "icon": {
          "light": "./media/images/file-code_light.svg",
          "dark": "./media/images/file-code_dark.svg"
        }
      },
      {
        "command": "fusionPowerUser.executeSQL",
        "title": "Execute dbt SQL",
        "category": "Fusion Power User",
        "icon": "$(play)"
      },
      {
        "command": "fusionPowerUser.buildCurrentModel",
        "title": "Build dbt Model",
        "category": "Fusion Power User",
        "icon": {
          "light": "./media/images/build-model_light.svg",
          "dark": "./media/images/build-model_dark.svg"
        }
      },
      {
        "command": "fusionPowerUser.buildChildrenModels",
        "title": "Build Downstream Models (model+)",
        "category": "Fusion Power User",
        "icon": {
          "light": "./media/images/build-model_light.svg",
          "dark": "./media/images/build-model_dark.svg"
        }
      },
      {
        "command": "fusionPowerUser.buildParentModels",
        "title": "Build Upstream Models (+model)",
        "category": "Fusion Power User",
        "icon": {
          "light": "./media/images/build-model_light.svg",
          "dark": "./media/images/build-model_dark.svg"
        }
      },
      {
        "command": "fusionPowerUser.buildChildrenParentModels",
        "title": "Build Upstream and Downstream Models (+model+)",
        "category": "Fusion Power User",
        "icon": {
          "light": "./media/images/build-model_light.svg",
          "dark": "./media/images/build-model_dark.svg"
        }
      },
      {
        "command": "fusionPowerUser.buildCurrentProject",
        "title": "Build dbt Project",
        "category": "Fusion Power User",
        "icon": {
          "light": "./media/images/build-model_light.svg",
          "dark": "./media/images/build-model_dark.svg"
        }
      },
      {
        "command": "fusionPowerUser.cleanCurrentProject",
        "title": "Clean dbt Project",
        "category": "Fusion Power User",
        "icon": "$(clear-all)"
      },
      {
        "command": "fusionPowerUser.diagnostics",
        "title": "Collect diagnostics",
        "category": "Fusion Power User",
        "icon": "$(debug-console)"
      },
      {
        "command": "fusionPowerUser.applyDeferConfig",
        "category": "Fusion Power User",
        "title": "Apply defer configuration"
      }
    ],
    "keybindings": [
      {
        "key": "Ctrl+Enter",
        "mac": "Cmd+Enter",
        "command": "fusionPowerUser.executeSQL",
        "when": "editorFocus && resourceLangId =~ /^sql$|^jinja-sql$/"
      },
      {
        "key": "Ctrl+'",
        "mac": "Cmd+'",
        "command": "fusionPowerUser.sqlPreview"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "fusionPowerUser.executeSQL",
          "when": "resourceLangId =~ /^sql$|^jinja-sql$/",
          "group": "navigation@1"
        },
        {
          "command": "fusionPowerUser.runCurrentModel",
          "when": "resourceLangId =~ /^sql$|^jinja-sql$/",
          "group": "navigation@3"
        },
        {
          "command": "fusionPowerUser.testCurrentModel",
          "when": "resourceLangId =~ /^sql$|^jinja-sql$/",
          "group": "navigation@4"
        },
        {
          "command": "fusionPowerUser.sqlPreview",
          "when": "resourceLangId =~ /^sql$|^jinja-sql$/",
          "group": "navigation@5"
        }
      ],
      "editor/context": [
        {
          "submenu": "fusionPowerUser.buildModel",
          "group": "dbt@5",
          "when": "resourceLangId =~ /^sql$|^jinja-sql$/"
        },
        {
          "command": "fusionPowerUser.showCompiledSQL",
          "group": "dbt@5",
          "when": "resourceLangId =~ /^sql$|^jinja-sql$/"
        },
        {
          "command": "fusionPowerUser.showRunSQL",
          "group": "dbt@6",
          "when": "resourceLangId =~ /^sql$|^jinja-sql$/"
        },
        {
          "command": "fusionPowerUser.goToDocumentationEditor",
          "group": "dbt@7",
          "when": "resourceLangId =~ /^sql$|^jinja-sql$/"
        },
        {
          "command": "fusionPowerUser.testCurrentModel",
          "group": "dbt@2",
          "when": "resourceLangId =~ /^sql$|^jinja-sql$/"
        },
        {
          "command": "fusionPowerUser.runCurrentModel",
          "group": "dbt@1",
          "when": "resourceLangId =~ /^sql$|^jinja-sql$/"
        },
        {
          "command": "fusionPowerUser.compileCurrentModel",
          "group": "dbt@4",
          "when": "resourceLangId =~ /^sql$|^jinja-sql$/"
        }
      ],
      "editor/title/run": [
        {
          "command": "fusionPowerUser.buildCurrentProject",
          "when": "resourceLangId =~ /^sql$|^jinja-sql$/",
          "group": "inline"
        },
        {
          "command": "fusionPowerUser.buildCurrentModel",
          "when": "resourceLangId =~ /^sql$|^jinja-sql$/",
          "group": "inline"
        },
        {
          "command": "fusionPowerUser.buildChildrenModels",
          "when": "resourceLangId =~ /^sql$|^jinja-sql$/",
          "group": "inline"
        },
        {
          "command": "fusionPowerUser.buildParentModels",
          "when": "resourceLangId =~ /^sql$|^jinja-sql$/",
          "group": "inline"
        },
        {
          "command": "fusionPowerUser.buildChildrenParentModels",
          "when": "resourceLangId =~ /^sql$|^jinja-sql$/",
          "group": "inline"
        },
        {
          "command": "fusionPowerUser.runCurrentModel",
          "when": "resourceLangId =~ /^sql$|^jinja-sql$/",
          "group": "inline"
        },
        {
          "command": "fusionPowerUser.cleanCurrentProject",
          "when": "resourceLangId =~ /^sql$|^jinja-sql$/",
          "group": "inline"
        }
      ],
      "view/title": [
        {
          "command": "fusionPowerUser.testCurrentModel",
          "when": "view == model_test_treeview",
          "group": "navigation"
        },
        {
          "command": "fusionPowerUser.runChildrenModels",
          "when": "view == children_model_treeview",
          "group": "navigation"
        },
        {
          "command": "fusionPowerUser.runParentModels",
          "when": "view == parent_model_treeview",
          "group": "navigation"
        },
        {
          "command": "fusionPowerUser.clearRunHistory",
          "when": "view == run_history_treeview",
          "group": "2_clear"
        }
      ],
      "view/item/context": [
        {
          "command": "fusionPowerUser.rerunFromHistory",
          "when": "view == run_history_treeview && viewItem == runHistoryEntry",
          "group": "inline"
        },
        {
          "command": "fusionPowerUser.runTest",
          "when": "view == model_test_treeview && viewItem != source",
          "group": "inline"
        },
        {
          "command": "fusionPowerUser.runChildrenModels",
          "when": "view == children_model_treeview && viewItem != source",
          "group": "inline"
        },
        {
          "command": "fusionPowerUser.runParentModels",
          "when": "view == parent_model_treeview && viewItem != source",
          "group": "inline"
        },
        {
          "command": "fusionPowerUser.copyModelName",
          "when": "(view == parent_model_treeview || view ==  children_model_treeview || view == documentation_treeview) && viewItem != source",
          "group": "navigation"
        },
        {
          "command": "fusionPowerUser.goToDocumentationEditor",
          "when": "view == documentation_treeview",
          "group": "inline"
        }
      ],
      "fusionPowerUser.buildModel": [
        {
          "command": "fusionPowerUser.buildCurrentModel",
          "when": "resourceLangId =~ /^sql$|^jinja-sql$/",
          "group": "inline"
        },
        {
          "command": "fusionPowerUser.buildChildrenModels",
          "when": "resourceLangId =~ /^sql$|^jinja-sql$/",
          "group": "inline"
        },
        {
          "command": "fusionPowerUser.buildParentModels",
          "when": "resourceLangId =~ /^sql$|^jinja-sql$/",
          "group": "inline"
        },
        {
          "command": "fusionPowerUser.buildChildrenParentModels",
          "when": "resourceLangId =~ /^sql$|^jinja-sql$/",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "fusionPowerUser.rerunFromHistory",
          "when": "false"
        },
        {
          "command": "fusionPowerUser.copyModelName",
          "when": "false"
        }
      ]
    },
    "submenus": [
      {
        "id": "fusionPowerUser.buildModel",
        "label": "Build dbt Model",
        "icon": {
          "light": "./media/images/build-model_light.svg",
          "dark": "./media/images/build-model_dark.svg"
        }
      }
    ],
    "languages": [
      {
        "id": "jinja-sql",
        "icon": {
          "light": "./media/images/dbt_file_icon.svg",
          "dark": "./media/images/dbt_file_icon.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "jinja-sql",
        "scopeName": "source.sql.jinja",
        "path": "./syntaxes/jinja-sql.tmLanguage.json"
      },
      {
        "scopeName": "source.yaml.jinja",
        "path": "./syntaxes/jinja-yaml.tmLanguage.json",
        "injectTo": [
          "source.yaml"
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build --prefix webview_panels && npm run build",
    "build": "rsbuild build",
    "build:dev": "rsbuild build --mode development",
    "watch:extension": "rsbuild build --mode development --watch",
    "compile": "tsc -p ./ --noEmit",
    "compile:integration": "tsc -p tsconfig.integration.json",
    "clean": "rimraf out coverage",
    "format": "prettier --write \"**/*.{js,css,html,json}\" \"scripts/**/*.mjs\"",
    "lint": "eslint src scripts --ext ts,mjs",
    "lint:fix": "eslint src scripts --ext ts,mjs --fix",
    "check:format": "prettier --check \"**/*.{js,css,html,json}\" \"scripts/**/*.mjs\"",
    "check:lockfile": "lockfile-lint --path package-lock.json --type npm --allowed-hosts npm --validate-https --validate-integrity",
    "check:lockfile:webviews": "lockfile-lint --path webview_panels/package-lock.json --type npm --allowed-hosts npm --validate-https --validate-integrity",
