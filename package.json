        "icon": "$(pass)"
      },
      {
        "command": "fusionPowerUser.runChildrenModels",
        "title": "Run Downstream Models",
        "category": "Fusion Power User",
        "icon": "$(run-below)"
      },
      {
        "command": "fusionPowerUser.runParentModels",
        "title": "Run Upstream Models",
        "category": "Fusion Power User",
        "icon": "$(run-above)"
      },
      {
        "command": "fusionPowerUser.copyModelName",
        "title": "Copy model name to clipboard",
        "category": "Fusion Power User"
      },
      {
        "command": "fusionPowerUser.showRunSQL",
        "title": "Open dbt target folder run SQL",
        "category": "Fusion Power User",
        "icon": {
          "light": "./media/images/file-code_light.svg",
          "dark": "./media/images/file-code_dark.svg"
        }
      },
      {
        "command": "fusionPowerUser.generateSchemaYML",
        "title": "Generate Documentation YML",
        "category": "Fusion Power User",
        "icon": {
          "light": "./media/images/file-code_light.svg",
          "dark": "./media/images/file-code_dark.svg"
        }
      },
      {
        "command": "fusionPowerUser.goToDocumentationEditor",
        "title": "Open Documentation Editor",
        "category": "Fusion Power User",
        "icon": {
          "light": "./media/images/file-code_light.svg",
          "dark": "./media/images/file-code_dark.svg"
        }
      },
      {
        "command": "fusionPowerUser.showCompiledSQL",
        "title": "Show compiled SQL",
        "category": "Fusion Power User",
        "icon": {
          "light": "./media/images/file-code_light.svg",
          "dark": "./media/images/file-code_dark.svg"
        }
      },
      {
        "command": "fusionPowerUser.executeSQL",
