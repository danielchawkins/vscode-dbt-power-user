{
  "name": "@fusion-power-user/webviews",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev:app": "vite",
    "watch:app": "rm -rf ../dist/webview && node ../node_modules/typescript-7/bin/tsc && vite build --watch",
    "build": "npm run build:packages --prefix .. && npm run build:app",
    "build:app": "rm -rf ../dist/webview && node ../node_modules/typescript-7/bin/tsc && vite build --emptyOutDir=false",
    "preview": "vite preview",
    "typecheck": "node ../node_modules/typescript-7/bin/tsc --noEmit && node ../node_modules/typescript-7/bin/tsc -p tsconfig.test.json --noEmit",
    "lint:oxlint": "oxlint --deny-warnings --type-aware .",
    "fix:oxlint": "oxlint --fix --type-aware .",
    "prune:oxlint": "oxlint --prune-suppressions --type-aware .",
    "lint:eslint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "lint:imports": "depcruise src --config .dependency-cruiser.cjs --output-type err",
    "fix:eslint": "eslint . --fix",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "prune:eslint": "eslint . --prune-suppressions"
  },
  "dependencies": {
    "@fusion-power-user/graph-layout": "*",
    "@fusion-power-user/webview-contract": "*",
    "@tanstack/react-table": "^9.2.6",
    "@tanstack/react-virtual": "^3.14.13",
    "@vscode/codicons": "^0.0.45",
    "@xyflow/react": "^12.12.0",
    "prismjs": "^1.30.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-error-boundary": "^6.1.6"
  },
  "devDependencies": {
    "@e18e/eslint-plugin": "0.8.1",
    "@eslint-react/eslint-plugin": "^5.20.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": ">=24.13.6 <24.19.0",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode-webview": "^1.57.5",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-oxlint": "1.87.0",
    "eslint-plugin-sonarjs": "^4.2.1",
    "fast-check": "^4.10.2",
    "happy-dom": "^21.0.1",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "npm:@typescript/typescript6@^6.0.0",
    "typescript-7": "npm:typescript@^7.0.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.0",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^5.0.3"
  }
}
