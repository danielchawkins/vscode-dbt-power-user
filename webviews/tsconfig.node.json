{
  "compilerOptions": {
    "erasableSyntaxOnly": true,
    "composite": true,
    "target": "ES2024",
    "lib": ["ES2024"],
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "verbatimModuleSyntax": true,
    "strictNullChecks": true
  },
  "include": ["vite.config.ts", "vitest.config.ts"]
}
