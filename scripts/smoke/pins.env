# Linux arm64 hosts, built from the darwin pins' commits and version. resolve-cursor-pin.sh rewrites the Cursor sha.
# Extracted layout, relative to the cache dir:
#   vscode-<version>-linux-arm64/VSCode-linux-arm64/{code,bin/code,resources/app/product.json}
#   cursor-<version>-linux-arm64/usr/share/cursor/{cursor,bin/cursor,resources/app/product.json}
# Cursor's product.json matches the darwin values (version, commit, vscodeVersion).
FPU_VSCODE_LINUX_PLATFORM=linux-arm64
FPU_VSCODE_LINUX_API=https://update.code.visualstudio.com/api/versions/${FPU_VSCODE_VERSION}/linux-arm64/stable
FPU_VSCODE_LINUX_SHA256=6fd05e1fe7b6f6540fc7a5aee555b49b3f761ef099186b4e2fd0c22d297ef27f

FPU_CURSOR_LINUX_PLATFORM=linux-arm64
FPU_CURSOR_LINUX_URL=${FPU_CURSOR_DOWNLOAD_BASE}/linux/arm64/deb/arm64/deb/cursor_${FPU_CURSOR_VERSION}_arm64.deb
FPU_CURSOR_LINUX_SHA256=496216a9a01c121be890faa0c6a236e0803366fad62dea92f62b4a03bb14a81e
