set shell := ["bash", "-euo", "pipefail", "-c"]
set positional-arguments

# Rust crates (contributor tooling, not shipped). The root justfile runs `crates::check` inside `just check`.
# Build output goes to CARGO_TARGET_DIR, or crates/target. wasm and napi write their outputs to dist/graph-layout.

# Fails with a message, not a skip, when mise has not installed cargo.
[private]
require-cargo:
    @command -v cargo >/dev/null || { echo "crates: cargo not found; run 'mise install' in the repository root" >&2; exit 1; }

[group("quality")]
fmt: require-cargo
    cargo fmt --all

[group("quality")]
fmt-check: require-cargo
    cargo fmt --all -- --check

[group("quality")]
lint-toolchain: require-cargo
    node ../scripts/quality/rust-toolchain.mjs

# Clippy is pedantic with warnings denied; the lint table lives in crates/Cargo.toml. `cargo doc` documents the whole
# workspace with warnings denied. In a jj workspace whose git store is a bare `.bare` repository, cargo cannot list a
# path package's files ("did not expect repo ... to be bare") and documents nothing. That error is a checkout-layout
# fact, not a documentation fault, so the recipe then documents a copy of the crates outside any repository, with the
# same Cargo.lock and the same target directory. Every other failure stops the recipe.
[group("quality")]
lint: require-cargo
    #!/usr/bin/env bash
    set -euo pipefail
    cargo clippy --workspace --all-targets --locked -- -D warnings
    log="${CARGO_TARGET_DIR:-target}/cargo-doc.log"
    mkdir -p "$(dirname "$log")"
    if ! RUSTDOCFLAGS='-D warnings' cargo doc --no-deps --workspace --locked 2>&1 | tee "$log"; then
        grep -q 'did not expect repo .* to be bare' "$log" || exit 1
        target_dir="${CARGO_TARGET_DIR:-$PWD/target}"
        case "$target_dir" in /*) ;; *) target_dir="$PWD/$target_dir" ;; esac
        copy=$(mktemp -d)
        trap 'rm -rf "$copy"' EXIT
        tar -c --exclude ./target -C "$PWD" . | tar -x -C "$copy"
        (cd "$copy" && RUSTDOCFLAGS='-D warnings' CARGO_TARGET_DIR="$target_dir" cargo doc --no-deps --workspace --locked)
    fi
    cargo machete
    typos

# Every feature combination of the core, its tests included (`--all-targets`), and the core for wasm32 (the wasm
# binding's target).
[group("quality")]
check-features: require-cargo
    cargo hack check --feature-powerset --all-targets --locked -p graph-layout
    cargo check --locked -p graph-layout --target wasm32-unknown-unknown --all-features

[group("tests")]
test: require-cargo
    cargo nextest run --workspace --locked --no-tests=pass
    cargo test --doc --workspace --locked

# Licences, advisories, sources and bans, from crates/deny.toml. Advisories need the RustSec database over the network.
[group("quality")]
deny: require-cargo
    cargo deny check licenses advisories bans sources

# The normal dependency tree of the core, with no features, with serde and with parallel, diffed against boundaries/.
[group("quality")]
boundaries: require-cargo
    #!/usr/bin/env bash
    set -euo pipefail
    status=0
    for set in default serde parallel; do
        features=()
        [[ "$set" == default ]] || features=(--features "$set")
        tree=$(cargo tree --locked -p graph-layout -e normal --prefix none --format '{p}' ${features[@]+"${features[@]}"} | sed 's/ (.*)$//')
        if ! diff -u "boundaries/$set.txt" <(printf '%s\n' "$tree"); then
            echo "boundaries: the $set dependency tree of graph-layout changed; see crates/boundaries/" >&2
            status=1
        fi
    done
    exit "$status"

# The WebAssembly binding: release build, wasm-bindgen nodejs glue, wasm-opt -O, and the sizes (S11), checked against
# the `dist/graph-layout` keys of `size` in ceilings.json.
[group("quality")]
wasm: require-cargo
    #!/usr/bin/env bash
    set -euo pipefail
    cargo build --locked --release -p graph-layout-wasm --target wasm32-unknown-unknown
    out=../dist/graph-layout
    mkdir -p "$out"
    wasm-bindgen --target nodejs --out-dir "$out" "${CARGO_TARGET_DIR:-target}/wasm32-unknown-unknown/release/graph_layout_wasm.wasm"
    # The nodejs glue is CommonJS; the root package.json says "type": "module", so mark this folder CommonJS.
    echo '{"type":"commonjs"}' > "$out/package.json"
    raw=$(wc -c < "$out/graph_layout_wasm_bg.wasm")
    wasm-opt -O "$out/graph_layout_wasm_bg.wasm" -o "$out/graph_layout_wasm_bg.wasm"
    opt=$(wc -c < "$out/graph_layout_wasm_bg.wasm")
    gz=$(gzip -9c "$out/graph_layout_wasm_bg.wasm" | wc -c)
    echo "wasm size: raw $raw bytes, wasm-opt -O $opt bytes, gzip -9 $gz bytes"
    node ../scripts/quality/size-budget.mjs --crates

# The Node-API binding: a release cdylib, copied to dist/ as .node. Built with cargo, not @napi-rs/cli: the crate has
# no JavaScript side of its own, and the CLI would add an npm dependency for one copy.
[group("quality")]
napi: require-cargo
    #!/usr/bin/env bash
    set -euo pipefail
    cargo build --locked --release -p graph-layout-napi
    mkdir -p ../dist/graph-layout
    case "$(uname -s)" in
      Darwin) lib=libgraph_layout_napi.dylib ;;
      MINGW* | MSYS* | CYGWIN*) lib=graph_layout_napi.dll ;;
      *) lib=libgraph_layout_napi.so ;;
    esac
    cp "${CARGO_TARGET_DIR:-target}/release/$lib" ../dist/graph-layout/graph_layout_napi.node

# Native and WebAssembly outputs compared byte for byte with the golden frame. `check` runs it, and CI runs it too.
[group("quality")]
parity: wasm napi
    node graph-layout-wasm/js/parity.mjs ../dist/graph-layout
    just solve-parity
    just layering-parity
    just order-parity

# The planted divergence for `parity`: a golden one byte off must make it exit 1, the mismatch status. Any other failure
# (a missing build, a crash) fails this recipe too, so the plant cannot pass by accident. `check` runs it after `parity`.
[group("quality")]
parity-plant: wasm napi
    #!/usr/bin/env bash
    set -euo pipefail
    tmp=$(mktemp -d)
    trap 'rm -rf "$tmp"' EXIT
    sed 's/^frame empty-layout 474c4652/frame empty-layout 474c4653/' graph-layout/fixtures/parity/frame.txt > "$tmp/frame.txt"
    status=0
    report=$(node graph-layout-wasm/js/parity.mjs ../dist/graph-layout "$tmp/frame.txt" 2>&1) || status=$?
    if [[ "$status" -ne 1 ]]; then
        echo "parity-plant: parity exited $status for a planted divergence; expected 1" >&2
        echo "$report" >&2
        exit 1
    fi
    # Exit 1 alone is not enough: a crash (a module that fails to load) also exits 1. Require the mismatch report.
    if ! grep -qE '^parity: (native|wasm) returned ' <<<"$report"; then
        echo "parity-plant: parity exited 1 without a mismatch report; this is a crash, not a divergence" >&2
        echo "$report" >&2
        exit 1
    fi
    just solve-parity-plant
    just layering-parity-plant
    just order-parity-plant

# The solver (`solve`, private to the core) run natively and under WASI: the core's whole test suite runs in
# WebAssembly through scripts/quality/wasi-run.mjs (Node's own WASI), and each run writes its 2,000 random outputs as
# IEEE bits for the comparison. Both outputs go to the directory given.
[private]
solve-outputs dir: require-cargo
    #!/usr/bin/env bash
    set -euo pipefail
    GRAPH_LAYOUT_SOLVE_OUT="$1/native.txt" cargo test --locked -p graph-layout random_outputs_are_written_for_the_parity_comparison
    GRAPH_LAYOUT_SOLVE_OUT="$1/wasm.txt" cargo test --locked --target wasm32-wasip1 -p graph-layout

# Native and WebAssembly solver outputs compared byte for byte (scripts/parity/compare-solve.mjs).
[group("quality")]
solve-parity: require-cargo
    #!/usr/bin/env bash
    set -euo pipefail
    tmp=$(mktemp -d)
    trap 'rm -rf "$tmp"' EXIT
    just solve-outputs "$tmp"
    node ../scripts/parity/compare-solve.mjs "$tmp/native.txt" "$tmp/wasm.txt"

# The planted divergence for `solve-parity`: one WebAssembly bit flipped on the first line must make the comparison
# exit 1 with its report. A missing file or a malformed output (exit 2) fails this recipe too.
[group("quality")]
solve-parity-plant: require-cargo
    #!/usr/bin/env bash
    set -euo pipefail
    tmp=$(mktemp -d)
    trap 'rm -rf "$tmp"' EXIT
    just solve-outputs "$tmp"
    awk 'NR==1{sub(/0,/,"1,")} 1' "$tmp/wasm.txt" > "$tmp/planted.txt"
    cmp -s "$tmp/wasm.txt" "$tmp/planted.txt" && { echo "solve-parity-plant: the plant changed nothing" >&2; exit 1; }
    status=0
    report=$(node ../scripts/parity/compare-solve.mjs "$tmp/native.txt" "$tmp/planted.txt" 2>&1) || status=$?
    if [[ "$status" -ne 1 ]]; then
        echo "solve-parity-plant: comparison exited $status for a planted divergence; expected 1" >&2
        echo "$report" >&2
        exit 1
    fi
    if ! grep -qE '^solve-parity: [0-9]+ of [0-9]+ outputs differ' <<<"$report"; then
        echo "solve-parity-plant: exit 1 without a difference report; this is a crash, not a divergence" >&2
        echo "$report" >&2
        exit 1
    fi

# The layering outputs (ranks, reversed edges and dummy chains of every fixture case) run natively and under WASI: the
# test writes them when GRAPH_LAYOUT_LAYERING_OUT names a file, and the WASI runner preopens that directory.
[private]
layering-outputs dir: require-cargo
    #!/usr/bin/env bash
    set -euo pipefail
    GRAPH_LAYOUT_LAYERING_OUT="$1/native.txt" cargo test --locked -p graph-layout layering_outputs_are_written_for_the_parity_comparison
    GRAPH_LAYOUT_LAYERING_OUT="$1/wasm.txt" cargo test --locked --target wasm32-wasip1 -p graph-layout layering_outputs_are_written_for_the_parity_comparison

# Compares two layering outputs byte for byte: exit 1 with a report when they differ, exit 2 when a file is unreadable or
# does not have one line per fixture case, so an empty output cannot pass.
[private]
layering-compare native wasm:
    #!/usr/bin/env bash
    set -uo pipefail
    cases=$(grep -cv '^#' graph-layout/fixtures/parity/layering-cases.txt)
    for f in "$1" "$2"; do
        if [[ ! -r "$f" ]] || [[ "$(wc -l < "$f" | tr -d ' ')" != "$cases" ]]; then
            echo "layering-parity: $f is unreadable or does not have $cases cases" >&2
            exit 2
        fi
    done
    if cmp -s "$1" "$2"; then
        echo "layering-parity: native and wasm outputs are byte-identical on $cases cases"
        exit 0
    fi
    echo "layering-parity: $(cmp -l "$1" "$2" 2>/dev/null | wc -l | tr -d ' ') bytes differ; native and wasm outputs differ"
    diff "$1" "$2" | head -6
    exit 1

# Native and WebAssembly layering outputs compared byte for byte.
[group("quality")]
layering-parity: require-cargo
    #!/usr/bin/env bash
    set -euo pipefail
    tmp=$(mktemp -d)
    trap 'rm -rf "$tmp"' EXIT
    just layering-outputs "$tmp"
    just layering-compare "$tmp/native.txt" "$tmp/wasm.txt"

# The order outputs (the crossings and the order of every fixture case at each effort) run natively and under WASI: the
# test writes them when GRAPH_LAYOUT_ORDER_OUT names a file, and the WASI runner preopens that directory.
[private]
order-outputs dir: require-cargo
    #!/usr/bin/env bash
    set -euo pipefail
    GRAPH_LAYOUT_ORDER_OUT="$1/native.txt" cargo test --locked -p graph-layout order_outputs_are_written_for_the_parity_comparison
    GRAPH_LAYOUT_ORDER_OUT="$1/wasm.txt" cargo test --locked --target wasm32-wasip1 -p graph-layout order_outputs_are_written_for_the_parity_comparison

# Compares two order outputs byte for byte: exit 1 with a report when they differ, exit 2 when a file is unreadable or
# does not have one line per fixture case, so an empty output cannot pass.
[private]
order-compare native wasm:
    #!/usr/bin/env bash
    set -uo pipefail
    cases=$(grep -c '^case' graph-layout/fixtures/parity/order.txt)
    for f in "$1" "$2"; do
        if [[ ! -r "$f" ]] || [[ "$(wc -l < "$f" | tr -d ' ')" != "$cases" ]]; then
            echo "order-parity: $f is unreadable or does not have $cases cases" >&2
            exit 2
        fi
    done
    if cmp -s "$1" "$2"; then
        echo "order-parity: native and wasm outputs are byte-identical on $cases cases"
        exit 0
    fi
    echo "order-parity: $(cmp -l "$1" "$2" 2>/dev/null | wc -l | tr -d ' ') bytes differ; native and wasm outputs differ"
    diff "$1" "$2" | head -6
    exit 1

# Native and WebAssembly order outputs compared byte for byte.
[group("quality")]
order-parity: require-cargo
    #!/usr/bin/env bash
    set -euo pipefail
    tmp=$(mktemp -d)
    trap 'rm -rf "$tmp"' EXIT
    just order-outputs "$tmp"
    just order-compare "$tmp/native.txt" "$tmp/wasm.txt"

# The planted divergence for `order-parity`: one WebAssembly hinted flag set on the first line must make the comparison
# exit 1 with its report. A missing file or a malformed output (exit 2) fails this recipe too.
[group("quality")]
order-parity-plant: require-cargo
    #!/usr/bin/env bash
    set -euo pipefail
    tmp=$(mktemp -d)
    trap 'rm -rf "$tmp"' EXIT
    just order-outputs "$tmp"
    awk 'NR==1{sub(/:false:/,":true:")} 1' "$tmp/wasm.txt" > "$tmp/planted.txt"
    cmp -s "$tmp/wasm.txt" "$tmp/planted.txt" && { echo "order-parity-plant: the plant changed nothing" >&2; exit 1; }
    status=0
    report=$(just order-compare "$tmp/native.txt" "$tmp/planted.txt" 2>&1) || status=$?
    if [[ "$status" -ne 1 ]]; then
        echo "order-parity-plant: comparison exited $status for a planted divergence; expected 1" >&2
        echo "$report" >&2
        exit 1
    fi
    if ! grep -qE '^order-parity: [0-9]+ bytes differ' <<<"$report"; then
        echo "order-parity-plant: exit 1 without a difference report; this is a crash, not a divergence" >&2
        echo "$report" >&2
        exit 1
    fi

# The planted divergence for `layering-parity`: one WebAssembly rank bit flipped on the first line must make the comparison
# exit 1 with its report. A missing file or a malformed output (exit 2) fails this recipe too.
[group("quality")]
layering-parity-plant: require-cargo
    #!/usr/bin/env bash
    set -euo pipefail
    tmp=$(mktemp -d)
    trap 'rm -rf "$tmp"' EXIT
    just layering-outputs "$tmp"
    awk -F'\t' 'BEGIN { OFS = "\t" } NR == 1 { sub(/^0/, "1", $2) } 1' "$tmp/wasm.txt" > "$tmp/planted.txt"
    cmp -s "$tmp/wasm.txt" "$tmp/planted.txt" && { echo "layering-parity-plant: the plant changed nothing" >&2; exit 1; }
    status=0
    report=$(just layering-compare "$tmp/native.txt" "$tmp/planted.txt" 2>&1) || status=$?
    if [[ "$status" -ne 1 ]]; then
        echo "layering-parity-plant: comparison exited $status for a planted divergence; expected 1" >&2
        echo "$report" >&2
        exit 1
    fi
    if ! grep -qE '^layering-parity: [0-9]+ bytes differ' <<<"$report"; then
        echo "layering-parity-plant: exit 1 without a difference report; this is a crash, not a divergence" >&2
        echo "$report" >&2
        exit 1
    fi

[group("quality")]
check:
    #!/usr/bin/env bash
    set -uo pipefail
    failed=()
    for step in lint-toolchain fmt-check lint check-features test deny boundaries parity parity-plant; do
        just "$step" || failed+=("crates::$step")
    done
    if ((${#failed[@]})); then
        echo "crates check failed: ${failed[*]}" >&2
        exit 1
    fi
