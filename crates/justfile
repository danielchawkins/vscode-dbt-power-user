set shell := ["bash", "-euo", "pipefail", "-c"]
set positional-arguments

# Rust crates (contributor tooling, not shipped). The root justfile runs `crates::check` inside `just check`.
# Build output goes to CARGO_TARGET_DIR, or crates/target. wasm and napi write their outputs to dist/graph-layout.

# Fails with a message, not a skip, when mise has not installed cargo.
[private]
require-cargo:
    @command -v cargo >/dev/null || { echo "crates: cargo not found; run 'mise install' in the repository root" >&2; exit 1; }

[group("quality")]
fmt: require-cargo
    cargo fmt --all

[group("quality")]
fmt-check: require-cargo
    cargo fmt --all -- --check

[group("quality")]
lint-toolchain: require-cargo
    node ../scripts/quality/rust-toolchain.mjs

# Clippy is pedantic with warnings denied; the lint table lives in crates/Cargo.toml. `cargo doc` documents the whole
# workspace with warnings denied. Its one fallback: in a jj workspace whose git store is a bare `.bare` repository,
# cargo cannot read a path package's file list ("did not expect repo ... to be bare") and cannot run at all. Only that
# failure falls back to rustdoc on the core, which has no dependencies; every other failure stops the recipe.
[group("quality")]
lint: require-cargo
    #!/usr/bin/env bash
    set -euo pipefail
    cargo clippy --workspace --all-targets --locked -- -D warnings
    log="${CARGO_TARGET_DIR:-target}/cargo-doc.log"
    mkdir -p "$(dirname "$log")"
    if ! RUSTDOCFLAGS='-D warnings' cargo doc --no-deps --workspace --locked 2>&1 | tee "$log"; then
        grep -q 'did not expect repo .* to be bare' "$log" || exit 1
        echo "crates: cargo doc cannot read this jj workspace's bare git store; documenting the core alone with rustdoc" >&2
        rustdoc --edition 2024 --crate-type lib -D warnings -D rustdoc::broken_intra_doc_links --out-dir "${CARGO_TARGET_DIR:-target}/rustdoc" graph-layout/src/lib.rs
    fi
    cargo machete
    typos

# Every feature combination of the core, and the core for wasm32 (the wasm binding's target).
[group("quality")]
check-features: require-cargo
    cargo hack check --feature-powerset --no-dev-deps --locked -p graph-layout
    cargo check --locked -p graph-layout --target wasm32-unknown-unknown --all-features

[group("tests")]
test: require-cargo
    cargo nextest run --workspace --locked --no-tests=pass
    cargo test --doc --workspace --locked

# Licences, advisories, sources and bans, from crates/deny.toml. Advisories need the RustSec database over the network.
[group("quality")]
deny: require-cargo
    cargo deny check licenses advisories bans sources

# The normal dependency tree of the core, with no features, with serde and with parallel, diffed against boundaries/.
[group("quality")]
boundaries: require-cargo
    #!/usr/bin/env bash
    set -euo pipefail
    status=0
    for set in default serde parallel; do
        features=()
        [[ "$set" == default ]] || features=(--features "$set")
        tree=$(cargo tree --locked -p graph-layout -e normal --prefix none --format '{p}' ${features[@]+"${features[@]}"} | sed 's/ (.*)$//')
        if ! diff -u "boundaries/$set.txt" <(printf '%s\n' "$tree"); then
            echo "boundaries: the $set dependency tree of graph-layout changed; see crates/boundaries/" >&2
            status=1
        fi
    done
    exit "$status"

# The WebAssembly binding: release build, wasm-bindgen nodejs glue, wasm-opt -O, and the sizes (S11).
[group("quality")]
wasm: require-cargo
    #!/usr/bin/env bash
    set -euo pipefail
    cargo build --locked --release -p graph-layout-wasm --target wasm32-unknown-unknown
    out=../dist/graph-layout
    mkdir -p "$out"
    wasm-bindgen --target nodejs --out-dir "$out" "${CARGO_TARGET_DIR:-target}/wasm32-unknown-unknown/release/graph_layout_wasm.wasm"
    # The nodejs glue is CommonJS; the root package.json says "type": "module", so mark this folder CommonJS.
    echo '{"type":"commonjs"}' > "$out/package.json"
    raw=$(wc -c < "$out/graph_layout_wasm_bg.wasm")
    wasm-opt -O "$out/graph_layout_wasm_bg.wasm" -o "$out/graph_layout_wasm_bg.wasm"
    opt=$(wc -c < "$out/graph_layout_wasm_bg.wasm")
    gz=$(gzip -9c "$out/graph_layout_wasm_bg.wasm" | wc -c)
    echo "wasm size: raw $raw bytes, wasm-opt -O $opt bytes, gzip -9 $gz bytes"

# The Node-API binding: a release cdylib, copied to dist/ as .node. Built with cargo, not @napi-rs/cli: the crate has
# no JavaScript side of its own, and the CLI would add an npm dependency for one copy.
[group("quality")]
napi: require-cargo
    #!/usr/bin/env bash
    set -euo pipefail
    cargo build --locked --release -p graph-layout-napi
    mkdir -p ../dist/graph-layout
    case "$(uname -s)" in
      Darwin) lib=libgraph_layout_napi.dylib ;;
      MINGW* | MSYS* | CYGWIN*) lib=graph_layout_napi.dll ;;
      *) lib=libgraph_layout_napi.so ;;
    esac
    cp "${CARGO_TARGET_DIR:-target}/release/$lib" ../dist/graph-layout/graph_layout_napi.node

# Native and WebAssembly outputs compared byte for byte with the golden. CI runs it; `check` does not.
[group("quality")]
parity: wasm napi
    node graph-layout-wasm/js/parity.mjs ../dist/graph-layout

# The planted divergence for `parity`: a golden one byte off must make it exit 1, the mismatch status. Any other failure
# (a missing build, a crash) fails this recipe too, so the plant cannot pass by accident. CI runs it after `parity`.
[group("quality")]
parity-plant: wasm napi
    #!/usr/bin/env bash
    set -euo pipefail
    tmp=$(mktemp -d)
    trap 'rm -rf "$tmp"' EXIT
    sed 's/"layout":0/"layout":1/' graph-layout-wasm/js/golden/layout.txt > "$tmp/layout.txt"
    status=0
    report=$(node graph-layout-wasm/js/parity.mjs ../dist/graph-layout "$tmp/layout.txt" 2>&1) || status=$?
    if [[ "$status" -ne 1 ]]; then
        echo "parity-plant: parity exited $status for a planted divergence; expected 1" >&2
        echo "$report" >&2
        exit 1
    fi
    # Exit 1 alone is not enough: a crash (a module that fails to load) also exits 1. Require the mismatch report.
    if ! grep -qE '^parity: (native|wasm) returned ' <<<"$report"; then
        echo "parity-plant: parity exited 1 without a mismatch report; this is a crash, not a divergence" >&2
        echo "$report" >&2
        exit 1
    fi

[group("quality")]
check:
    #!/usr/bin/env bash
    set -uo pipefail
    failed=()
    for step in lint-toolchain fmt-check lint check-features test deny boundaries; do
        just "$step" || failed+=("crates::$step")
    done
    if ((${#failed[@]})); then
        echo "crates check failed: ${failed[*]}" >&2
        exit 1
    fi
