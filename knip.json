{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "src/extension.ts",
        "src/test/**/*.ts",
        "scripts/**/*.{mjs,ts}",
        "rsbuild.config.ts",
        "vitest.config.ts"
      ],
      "project": ["src/**/*.ts", "scripts/**/*.{mjs,ts}"],
      "ignore": [
        "src/test/fixtures/**",
        "src/test/mock/**",
        "scripts/spikes/**"
      ],
      "ignoreDependencies": ["@types/vscode", "ts-loader"],
      "ignoreBinaries": ["sample", "dbt"]
    },
    "packages/webview-contract": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "webview_panels": {
      "entry": ["src/entries/*.tsx", "src/**/*.test.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": ["@vscode/codicons"]
    }
  }
}
