{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "tags": ["-internal"],
  "workspaces": {
    ".": {
      "entry": [
        "src/test/**/*.test.ts",
        "src/test/{integration,smoke}/**/*.ts",
        "src/test/mock/{extensionRoot,vscode,vscode-languageclient-node}.ts",
        "scripts/**/*.{mjs,ts}",
        ".vscode-test.mjs"
      ],
      "project": ["src/**/*.ts!", "scripts/**/*.{mjs,ts}", "!src/test/**!"],
      "ignore": ["scripts/spikes/**"],
      "ignoreBinaries": ["dbt", "sample"],
      // oxlint and oxlint-tsgolint run only as binaries: `oxlint --type-aware` spawns tsgolint.
      "ignoreDependencies": ["type-coverage", "oxlint", "oxlint-tsgolint"]
    },
    "packages/webview-contract": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts!", "!src/**/*.test.ts!"]
    },
    "webview_panels": {
      "entry": ["src/entries/*.tsx!", "src/**/*.test.{ts,tsx}"],
      "project": [
        "src/**/*.{ts,tsx}!",
        "!src/**/*.test.{ts,tsx}!",
        "!src/test/**!"
      ],
      // Same as the root: oxlint and oxlint-tsgolint run only as binaries, never through an import.
      "ignoreDependencies": ["@vscode/codicons", "oxlint", "oxlint-tsgolint"]
    }
  }
}
