{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "src/extension.ts",
        "src/test/**/*.ts",
        "scripts/**/*.{mjs,ts}",
        "rsbuild.config.ts",
        "vitest.config.ts"
      ],
      "project": ["src/**/*.ts", "scripts/**/*.{mjs,ts}"],
      "ignore": ["src/test/fixtures/**", "src/test/mock/**"],
      "ignoreDependencies": ["@types/vscode", "ts-loader"],
      "ignoreBinaries": ["sample", "dbt"]
    }
  },
  "ignoreWorkspaces": ["webview_panels"]
}
