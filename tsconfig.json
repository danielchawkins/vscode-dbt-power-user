{
  "compilerOptions": {
    "module": "ESNext",
    "target": "ES2024",
    "outDir": "out",
    "noEmit": true,
    "tsBuildInfoFile": "out/tsconfig.tsbuildinfo",
    "lib": ["ES2024"],
    "sourceMap": true,
    "rootDir": ".",
    // "rootDirs": ["src", "../altimate-dbt-integration/src"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowJs": true,
    "checkJs": false,
    "moduleResolution": "bundler",
    "types": ["node", "mocha", "vscode"]
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    ".vscode-test",
    "webview_panels",
    "dist",
    "out",
    "src/test",
    "src/**/*.test.ts"
  ],
  "references": [{ "path": "./packages/webview-contract" }]
}
