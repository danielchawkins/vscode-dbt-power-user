{
  "compilerOptions": {
    "module": "ESNext",
    "target": "ES2020",
    "outDir": "out",
    "noEmit": true,
    "tsBuildInfoFile": "out/tsconfig.tsbuildinfo",
    "lib": ["ES2020"],
    "sourceMap": true,
    "rootDir": ".",
    // "rootDirs": ["src", "../altimate-dbt-integration/src"],
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowJs": true,
    "checkJs": false,
    "moduleResolution": "bundler",
    "types": ["node", "mocha", "vscode"],
    "paths": {
      "@extension": ["./src/modules.ts"]
    }
  },
  "include": ["src/**/*", "packages/webview-contract/src/**/*.test.ts"],
  "exclude": ["node_modules", ".vscode-test", "webview_panels", "dist", "out"],
  "references": [{ "path": "./packages/webview-contract" }]
}
