{
  // See https://go.microsoft.com/fwlink/?LinkId=733558
  // for the documentation about the tasks.json format
  "version": "2.0.0",
  "tasks": [
    {
      "label": "just watch",
      "type": "shell",
      "command": "just watch",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^([^\\s].*)\\((\\d+|\\d+,\\d+|\\d+,\\d+,\\d+,\\d+)\\):\\s+(error|warning|info)\\s+(TS\\d+)\\s*:\\s*(.*)$",
          "file": 1,
          "location": 2,
          "severity": 3,
          "code": 4,
          "message": 5
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*build started.*",
          "endsPattern": "^.*built in.*"
        }
      }
    },
    {
      "label": "just build",
      "type": "shell",
      "command": "just build",
      "problemMatcher": []
    },
    {
      "label": "just compile",
      "type": "shell",
      "command": "just compile",
      "problemMatcher": "$tsc"
    },
    {
      "label": "terminate just watch",
      "command": "echo ${input:terminate-just-watch}",
      "type": "shell",
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "terminate-just-watch",
      "type": "command",
      "command": "workbench.action.tasks.terminate",
      "args": "just watch"
    }
  ]
}
