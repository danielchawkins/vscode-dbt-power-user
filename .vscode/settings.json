{
  //////////////////////////////////////////////////////////////////////////////
  // Editor
  //////////////////////////////////////////////////////////////////////////////
  "editor.formatOnSave": true,
  "editor.rulers": [119],

  //////////////////////////////////////////////////////////////////////////////
  // Formatters. Oxlint and ESLint lint code; oxfmt formats it; dprint and rumdl own Markdown.
  // Naming one formatter per language stops the picker from asking.
  //////////////////////////////////////////////////////////////////////////////
  "[typescript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[javascript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[css]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[markdown]": {
    "editor.defaultFormatter": "dprint.dprint",
    "editor.wordWrap": "bounded",
    "editor.wordWrapColumn": 119,
    "editor.codeActionsOnSave": {
      "source.fixAll.rumdl": "explicit"
    }
  },

  //////////////////////////////////////////////////////////////////////////////
  // TypeScript. Build tasks are Just recipes, so tsc auto-detection adds noise.
  //////////////////////////////////////////////////////////////////////////////
  "typescript.tsc.autoDetect": "off",
  "typescript.preferences.importModuleSpecifier": "relative",

  //////////////////////////////////////////////////////////////////////////////
  // Upstream dbt Power User (innoverio). The fixtures are not projects to build;
  // without these it reports "dbt not found" on every fixture dbt_project.yml.
  // Fusion Power User reads fusionPowerUser.*, so neither setting reaches it.
  //////////////////////////////////////////////////////////////////////////////
  // Honored only by the finance-pipelines patched build (`just patch-dbt-power-user`).
  "dbt.enabled": false,
  // Stock builds: an existing folder with no dbt_project.yml matches no project.
  // A missing folder is dropped, and an empty list disables filtering.
  "dbt.allowListFolders": [".vscode"],

  //////////////////////////////////////////////////////////////////////////////
  // Noise. Build output, caches, generated dependencies, and compatibility links.
  //////////////////////////////////////////////////////////////////////////////
  "files.exclude": {
    "**/__pycache__": true,
    "**/.claude": true,
    "**/.nyc_output": true,
    "**/.rumdl_cache": true,
    "**/.vscode-test": true,
    "**/coverage": true,
    "**/dist": true,
    "**/node_modules": true,
    "**/out": true,
    "**/CLAUDE.md": true,
    "*.vsix": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/out": true,
    "**/package-lock.json": true
  },
  "files.watcherExclude": {
    "**/dist/**": true,
    "**/node_modules/**": true,
    "**/out/**": true
  },

  //////////////////////////////////////////////////////////////////////////////
  // File nesting. Empty anchor files are deliberate Explorer group headings,
  // matching the finance-pipelines workspace convention.
  //////////////////////////////////////////////////////////////////////////////
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    ".git-dotfiles": ".gitignore, lefthook.yml",
    ".workspace-dotfiles": "justfile, dprint.json, mise.toml, mise.lock, mise.local.toml, rumdl.toml, sgconfig.yml",
    ".typescript-dotfiles": "package.json, package-lock.json, tsconfig*.json, rsbuild.config.ts, vitest.config.ts, .vscode-test.mjs, eslint.config.mjs, eslint-suppressions.json, oxlint.config.ts, oxlint-suppressions.json, .oxfmtrc.json, knip.json, .dependency-cruiser.cjs",
    "README.md": "AGENTS.md, CONTEXT.md, LICENSE, *.md"
  }
}
