set shell := ["bash", "-euo", "pipefail", "-c"]
set positional-arguments
set default-list

export PATH := `mise bin-paths 2>/dev/null | tr '\n' ':' || true` + env("PATH")

####################
# Development
####################

[group("development")]
dev:
    #!/usr/bin/env bash
    set -euo pipefail
    npm run build:contract
    trap 'trap - EXIT; kill 0' EXIT INT TERM HUP
    npm run watch --prefix ../packages/webview-contract &
    npm run dev:app &
    wait

[group("development")]
watch:
    #!/usr/bin/env bash
    set -euo pipefail
    npm run build:contract
    trap 'trap - EXIT; kill 0' EXIT INT TERM HUP
    npm run watch --prefix ../packages/webview-contract &
    npm run watch:app &
    wait

[group("development")]
build:
    npm run build

[group("development")]
preview:
    npm run preview

####################
# Code quality
####################

[group("quality")]
typecheck:
    npm run typecheck

[group("quality")]
fmt:
    npm run lint:fix

[group("quality")]
lint:
    npm run lint

# Drop baseline entries for lint violations that have been fixed, so the baseline only shrinks.
[group("quality")]
lint-prune:
    npm run lint:prune

[group("tests")]
test *args:
    npm test -- "$@"
