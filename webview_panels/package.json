{
  "name": "webview_panels",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "build:contract": "npm run build --prefix ../packages/webview-contract",
    "dev": "npm run build:contract && concurrently --names contract,webview \"npm run watch --prefix ../packages/webview-contract\" \"npm run dev:app\"",
    "dev:app": "vite",
    "watch": "npm run build:contract && concurrently --names contract,webview \"npm run watch --prefix ../packages/webview-contract\" \"npm run watch:app\"",
    "watch:app": "rm -rf dist && tsc && vite build --watch",
    "build": "npm run build:contract && npm run build:app",
    "build:app": "rm -rf dist && NODE_OPTIONS=--max-old-space-size=8192 tsc && NODE_OPTIONS=--max-old-space-size=8192 vite build --emptyOutDir=false && bash ../scripts/workspace/check-webview-tailwind-css.sh dist/assets/lineage.css",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:prune": "eslint . --prune-suppressions"
  },
  "dependencies": {
    "@altimateai/ui-components": "^0.0.88",
    "@finos/perspective": "^3.8.0",
    "@finos/perspective-viewer": "^3.8.0",
    "@finos/perspective-viewer-d3fc": "^3.8.0",
    "@finos/perspective-viewer-datagrid": "^3.8.0",
    "@fusion-power-user/webview-contract": "*",
    "@reduxjs/toolkit": "^2.12.0",
    "@vscode/codicons": "^0.0.45",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-error-boundary": "^6.1.6",
    "react-select": "^5.10.2",
    "react-syntax-highlighter": "^16.1.1",
    "use-debounce": "^10.1.1",
    "vite-plugin-svgr": "^5.2.0"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.20.3",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/vscode-webview": "^1.57.5",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-sonarjs": "^4.2.1",
    "eslint-plugin-you-dont-need-lodash-underscore": "^6.14.0",
    "fast-check": "^4.10.2",
    "globals": "^16.4.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
