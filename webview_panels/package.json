{
  "name": "webview_panels",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "build:contract": "npm run build --prefix ../packages/webview-contract",
    "dev": "npm run build:contract && concurrently --names contract,webview \"npm run watch --prefix ../packages/webview-contract\" \"npm run dev:app\"",
    "dev:app": "vite",
    "watch": "npm run build:contract && concurrently --names contract,webview \"npm run watch --prefix ../packages/webview-contract\" \"npm run watch:app\"",
    "watch:app": "rm -rf dist && tsc && vite build --watch",
    "build": "npm run build:contract && npm run build:app",
    "build:app": "rm -rf dist && tsc && vite build --emptyOutDir=false",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0 && npm run lint:imports",
    "lint:imports": "depcruise src --config .dependency-cruiser.cjs --output-type err",
    "lint:fix": "eslint . --fix",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "lint:prune": "eslint . --prune-suppressions"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@fusion-power-user/webview-contract": "*",
    "@perspective-dev/client": "5.5.1",
    "@perspective-dev/server": "5.5.1",
    "@perspective-dev/viewer": "5.5.1",
    "@perspective-dev/viewer-charts": "5.5.1",
    "@perspective-dev/viewer-datagrid": "5.5.1",
    "@vscode/codicons": "^0.0.45",
    "@xyflow/react": "^12.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-error-boundary": "^6.1.6",
    "react-syntax-highlighter": "^16.1.1"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.20.3",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/vscode-webview": "^1.57.5",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-sonarjs": "^4.2.1",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "jsdom": "^30.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.0",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^5.0.3"
  }
}
