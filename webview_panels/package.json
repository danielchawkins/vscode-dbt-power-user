{
  "name": "webview_panels",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "vite",
    "watch": "rm -rf dist && tsc && vite build --watch",
    "build": "rm -rf dist && NODE_OPTIONS=--max-old-space-size=8192 tsc && NODE_OPTIONS=--max-old-space-size=8192 vite build --emptyOutDir=false && bash ../scripts/workspace/check-webview-tailwind-css.sh dist/assets/main.css",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 59",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@altimateai/ui-components": "^0.0.88",
    "@finos/perspective": "^3.8.0",
    "@finos/perspective-viewer": "^3.8.0",
    "@finos/perspective-viewer-d3fc": "^3.8.0",
    "@finos/perspective-viewer-datagrid": "^3.8.0",
    "@hookform/resolvers": "^5.9.1",
    "@reduxjs/toolkit": "^2.12.0",
    "@vscode/codicons": "^0.0.45",
    "bootstrap": "^5.3.8",
    "react": "^18.3.1",
    "react-copy-to-clipboard": "^5.1.1",
    "react-dom": "^18.3.1",
    "react-error-boundary": "^6.1.6",
    "react-hook-form": "^7.88.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "react-select": "^5.10.2",
    "react-syntax-highlighter": "^16.1.1",
    "reactstrap": "^9.2.3",
    "remark-gfm": "^4.0.1",
    "use-debounce": "^10.1.1",
    "vite-plugin-svgr": "^5.2.0",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.20.3",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-links": "^10.6.0",
    "@storybook/builder-vite": "^10.6.0",
    "@storybook/react": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.31",
    "@types/react-copy-to-clipboard": "^5.0.7",
    "@types/react-dom": "^18.3.7",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/vscode-webview": "^1.57.5",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-storybook": "^10.6.0",
    "eslint-plugin-you-dont-need-lodash-underscore": "^6.14.0",
    "factory.ts": "^1.4.2",
    "globals": "^16.4.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.28",
    "sass": "^1.104.1",
    "storybook": "^10.6.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "uuid": "^14.0.0",
    "@babel/runtime": "^7.26.10",
    "serialize-javascript": "^7.0.0",
    "brace-expansion": "^2.0.2",
    "minimatch": "^9.0.7"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "es5-ext": false
  }
}
