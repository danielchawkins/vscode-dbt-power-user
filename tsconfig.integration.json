{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "bundler",
    "outDir": "out",
    "noEmit": false,
    "tsBuildInfoFile": null,
    "rootDir": "src",
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    ".vscode-test",
    "webview_panels",
    "dist",
    "out",
    "src/test/suite/**/*",
    "src/test/mock/**/*",
    "src/test/esmDirname.ts"
  ]
}
